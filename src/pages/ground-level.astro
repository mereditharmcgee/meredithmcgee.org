---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SubstackFeed from '../components/SubstackFeed.astro';
import { SITE_TITLE, SUBSTACK_URL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Ground Level | ${SITE_TITLE}`} description="Ground Level is Meredith McGee's Substack about cannabis, public health, and the gap between policy and practice." />
	</head>
	<body>
		<Header />

		<section class="gl-intro bg-dark bg-pattern">
			<div class="container">
				<h1>Ground Level</h1>
				<p class="gl-description">Ground Level is my Substack about cannabis, public health, and the gap between policy and practice.</p>
				<div class="gl-cta">
					<a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class="btn">
						Subscribe on Substack
					</a>
				</div>
			</div>
		</section>

		<section class="gl-posts bg-dark">
			<div class="container">
				<h2>Recent posts</h2>
				<SubstackFeed limit={6} />
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	.gl-intro {
		padding-top: 6rem;
		padding-bottom: 3rem;
		text-align: center;
	}

	.gl-intro .container {
		max-width: 800px;
		padding: 0 2rem;
	}

	.gl-intro h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1.5rem;
	}

	.gl-description {
		font-size: clamp(0.95rem, 1.1vw, 1.1rem);
		line-height: 1.8;
		max-width: 600px;
		margin: 0 auto;
		opacity: 0.95;
	}

	.gl-cta {
		margin-top: 2rem;
	}

	.gl-posts {
		padding: 3rem 0 4rem;
	}

	.gl-posts .container {
		max-width: 800px;
		padding: 0 2rem;
	}

	.gl-posts h2 {
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		margin-bottom: 1.5rem;
		text-align: center;
	}

	@media (max-width: 768px) {
		.gl-intro {
			padding-top: 5rem;
		}
	}
</style>
