---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StudyFindings from '../components/study/Findings.astro';
import StudyPeople from '../components/study/People.astro';
import StudyPress from '../components/study/Press.astro';
import StudyReport from '../components/study/Report.astro';
import StudyTrio from '../components/study/Trio.astro';
import { CONTACT_EMAIL, SITE_TITLE, SUBSTACK_URL } from '../consts';
import { pillars } from '../data/approach';
import { build, chapterBar, closing, fund, hero, howIWork, study, write } from '../data/home';
import { projects } from '../data/projects';
import { moreAboutStudy } from '../data/study';
import { clips } from '../data/writing';
import { coverFor } from '../lib/covers';
import { getGroundLevelPosts } from '../lib/groundLevel';
import '../styles/home.css';

// The research and talks rail: everything in the project list except the
// product deck and the fundraising prospectus, which have their own sections.
const rail = projects.filter((p) => p.tone === 'research' || p.tone === 'practice' || p.tone === 'policy');

// Ground Level: the three newest posts from the live feed.
const groundLevel = await getGroundLevelPosts(3, { covers: true });
const posts = groundLevel.posts.map((p) => ({
	...p,
	cover: coverFor(p),
	dateLabel: p.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' }),
}));
const [lead, ...morePosts] = posts;

const inPrint = clips.find((c) => c.featured) ?? clips[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description="Meredith McGee is a public health researcher, writer, and builder in Boston." />
	</head>
	<body>
		<Header />
		<main id="main" class="page-home">
			<section class="s-hero wrap">
				<p class="label">{hero.kicker}</p>
				<h1 class="s-sentence">{hero.sentence.map((part) => (typeof part === 'string' ? part : <a class={`verb v-${part.verb}`} href={`#ch-${part.verb}`} data-jump={`ch-${part.verb}`}>{part.verb}</a>))}</h1>
				<div class="s-intro">
					<div class="s-photo"><img src={hero.photo.src} alt={hero.photo.alt} width={hero.photo.width} height={hero.photo.height} /></div>
					<div class="s-intro-text">
						<p class="lede">{hero.lede}</p>
						<p class="cta">
							<a class="btn solid" href={hero.links.workWithMe.href}>{hero.links.workWithMe.label}</a>
							<a class="textlink" href={hero.links.howIWork.href}>{hero.links.howIWork.label}</a>
							<a class="textlink" href={hero.links.story.href}>{hero.links.story.label}</a>
						</p>
					</div>
				</div>
			</section>

			<nav class="chapbar" aria-label={chapterBar.label}>
				<div class="wrap chapbar-in">
					<span class="chapbar-i" aria-hidden="true">{chapterBar.lead}</span>
					{(['study', 'write', 'build', 'fund'] as const).map((verb) => (
						<a href={`#ch-${verb}`} data-jump={`ch-${verb}`} data-ch={`ch-${verb}`}>{verb}</a>
					))}
					<a class="chapbar-cta" href={chapterBar.cta.href}>{chapterBar.cta.label}</a>
				</div>
			</nav>

			<section class="chapter-band c-study" id="ch-study">
				<div class="wrap ch">
					<div class="ch-head">
						<h2 class="ch-clause">{study.clause.before}<span class="verb-s">study</span>{study.clause.after}</h2>
						<p class="ch-where">{study.where}</p>
					</div>
					<div class="ch-body">
						<div class="rv"><StudyReport /></div>
						<div class="rv"><StudyTrio /></div>
						<StudyPeople reveal />
						<div class="rv"><StudyFindings /></div>
						<StudyPress reveal />
						<p class="rv"><a class="textlink" href={moreAboutStudy.href}>{moreAboutStudy.label} <span aria-hidden="true">→</span></a></p>
					</div>
				</div>
				<div class="wrap wide rail-wrap rv">
					<div class="sec-head">
						<p class="label">{study.rail.label}</p>
						<a class="more" href={study.rail.more.href}>{study.rail.more.label}</a>
					</div>
					<div class="hscroll" tabindex="0" role="group" aria-label={study.rail.scrollLabel}>
						{rail.map((p) => (
							<article class="mini has-img">
								<a class="mini-img" href={p.pdf} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><img src={p.thumb.src} alt="" width={p.thumb.width} height={p.thumb.height} loading="lazy" /></a>
								<p class="label olive">{p.tag} <span class="role">{p.format}</span></p>
								<h4 class="mini-h">{p.title}</h4>
								<p class="caption">{p.role}</p>
								<a class="go" href={p.pdf} target="_blank" rel="noopener">{p.cta} <span aria-hidden="true">↗</span></a>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="chapter-band c-write" id="ch-write">
				<div class="wrap ch">
					<div class="ch-head">
						<h2 class="ch-clause">{write.clause.before}<span class="verb-s">write</span>{write.clause.after}</h2>
						<p class="ch-where gl-where"><img src="/img/brand/gl-avatar-96.png" alt="" width="28" height="28" loading="lazy" />{write.where}</p>
						<p class="ch-aside">{write.aside}</p>
					</div>
					<div class="ch-body">
						{groundLevel.stale || !lead ? (
							<p class="rv"><a class="textlink" href={SUBSTACK_URL} target="_blank" rel="noopener">{write.staleLink} <span aria-hidden="true">↗</span></a></p>
						) : (
							<Fragment>
								<article class="latest rv">
									{lead.cover && (
										<a class="pic lead" href={lead.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><img src={lead.cover} alt="" width="1000" height="562" loading="lazy" /></a>
									)}
									<p class="label">{write.latestLabel} · {lead.dateLabel}</p>
									<h3 class="latest-h"><a href={lead.url} target="_blank" rel="noopener">{lead.title}</a></h3>
									<p class="body-lg">{lead.excerpt}</p>
								</article>
								{morePosts.length > 0 && (
									<div class="picrow rv">
										{morePosts.map((post) => (
											<article class="postpic">
												{post.cover ? (
													<Fragment>
														<a class="pic" href={post.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><img src={post.cover} alt="" width="800" height="450" loading="lazy" /></a>
														<p class="label">{post.dateLabel}</p>
														<h4 class="h4"><a href={post.url} target="_blank" rel="noopener">{post.title}</a></h4>
													</Fragment>
												) : (
													<Fragment>
														<h4 class="titlecard"><a href={post.url} target="_blank" rel="noopener">{post.title}</a></h4>
														<p class="label">{post.dateLabel}</p>
													</Fragment>
												)}
											</article>
										))}
									</div>
								)}
							</Fragment>
						)}
						<article class="inprint rv">
							<p class="label">{write.inPrintLabel} · {inPrint.outlet} · {inPrint.date}</p>
							<h3 class="h3"><a href={inPrint.href} target="_blank" rel="noopener">{inPrint.title}</a></h3>
							<p class="cta">
								<a class="go" href={inPrint.href} target="_blank" rel="noopener">Read in {inPrint.outlet} <span aria-hidden="true">↗</span></a>
								<a class="textlink" href={write.allWriting.href}>{write.allWriting.label}</a>
							</p>
						</article>
					</div>
				</div>
			</section>

			<section class="chapter-band c-build" id="ch-build">
				<div class="wrap ch">
					<div class="ch-head">
						<h2 class="ch-clause">{build.clause.before}<span class="verb-s">build</span>{build.clause.after}</h2>
						<p class="ch-where">{build.where}</p>
					</div>
					<div class="ch-body">
						<article class="feature rv">
							<figure class="feature-fig"><a href={build.feature.site} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><img src={build.feature.image.src} alt="" width={build.feature.image.width} height={build.feature.image.height} loading="lazy" /></a></figure>
							<div class="statrow">
								<div class="bigstat">
									<p class="stat xl" data-count={build.feature.stat.count}>{build.feature.stat.count}</p>
									<p class="caption">{build.feature.stat.caption}</p>
								</div>
								<div class="statrow-text">
									<h3 class="h2">{build.feature.title}</h3>
									<p class="body-lg">{build.feature.text}</p>
								</div>
							</div>
							<p class="cta">
								<a class="btn" href={build.feature.caseStudy.href}>{build.feature.caseStudy.label}</a>
								<a class="textlink" href={build.feature.visit.href} target="_blank" rel="noopener">{build.feature.visit.label} <span aria-hidden="true">↗</span></a>
								<a class="textlink" href={build.feature.thinking.href}>{build.feature.thinking.label}</a>
							</p>
						</article>
						<div class="duo rv">
							{build.cards.map((card) => (
								<article class="shot">
									<a class="pic" href={card.link.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><img src={card.image.src} alt="" width={card.image.width} height={card.image.height} loading="lazy" /></a>
									<p class="label olive">{card.label}</p>
									<h3 class="h4">{card.title}</h3>
									<p class="card-text">{card.text}</p>
									<a class="go" href={card.link.href} target="_blank" rel="noopener">{card.link.label} <span aria-hidden="true">↗</span></a>
								</article>
							))}
						</div>
					</div>
				</div>
			</section>

			<section class="chapter-band c-fund" id="ch-fund">
				<div class="wrap ch">
					<div class="ch-head">
						<h2 class="ch-clause">{fund.clause.before}<span class="verb-s">fund</span>{fund.clause.after}</h2>
						<p class="ch-where">{fund.where}</p>
					</div>
					<div class="ch-body">
						<div class="bigstat rv">
							<p class="stat xxl" data-count={fund.stat.count} data-prefix={fund.stat.prefix} data-suffix={fund.stat.suffix} data-final={fund.stat.final}>{fund.stat.final}</p>
							<p class="caption">{fund.stat.caption}</p>
						</div>
						<p class="pullline rv">{fund.pullline}</p>
						<div class="duo rv">
							{fund.figures.map((fig) => (
								<figure class="shot">
									{fig.href ? (
										<a class="pic tall" href={fig.href} target="_blank" rel="noopener"><img src={fig.image.src} alt={fig.image.alt} width={fig.image.width} height={fig.image.height} loading="lazy" /></a>
									) : (
										<div class="pic tall"><img src={fig.image.src} alt={fig.image.alt} width={fig.image.width} height={fig.image.height} loading="lazy" /></div>
									)}
									<figcaption class="caption">{fig.caption}</figcaption>
								</figure>
							))}
						</div>
						<p class="cta rv">
							<a class="btn onbrand" href={fund.workWithMe.href}>{fund.workWithMe.label}</a>
							<a class="textlink" href={fund.caseStudy.href}>{fund.caseStudy.label}</a>
						</p>
					</div>
				</div>
			</section>

			<section class="wrap sec tease rv">
				<div class="sec-head">
					<h2 class="h2">{howIWork.heading}</h2>
					<a class="more" href={howIWork.more.href}>{howIWork.more.label}</a>
				</div>
				<ul class="tease-list">
					{pillars.map((p) => (
						<li class={p.color}><a href={`/how-i-work#${p.id}`}><span class="tease-t word">{p.name}</span></a></li>
					))}
				</ul>
			</section>

			<section class="wrap sec s-close">
				<div class="close rv">
					<figure class="ember"><img src={closing.ember.src} alt={closing.ember.alt} width={closing.ember.width} height={closing.ember.height} loading="lazy" /></figure>
					<div class="stack">
						<p class="body-lg measure">{closing.text.before}<a href={closing.text.link.href}>{closing.text.link.label}</a>{closing.text.after}</p>
						<p class="reach">
							<span class="email">{CONTACT_EMAIL}</span>
							<a class="more" href={closing.cv.href} target="_blank" rel="noopener">{closing.cv.label}</a>
						</p>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	// The sticky verb bar: underline the section that is in view.
	import { onPage } from '../scripts/page';

	onPage((signal) => {
		const links = Array.from(document.querySelectorAll<HTMLElement>('[data-ch]'));
		if (!links.length) return;
		const chapters = links.map((a) => document.getElementById(a.dataset.ch || ''));
		function spy() {
			let current = -1;
			const line = window.innerHeight * 0.45;
			chapters.forEach((c, i) => {
				if (c && c.offsetParent !== null && c.getBoundingClientRect().top < line) current = i;
			});
			links.forEach((a, i) => {
				if (i === current) a.setAttribute('aria-current', 'true');
				else a.removeAttribute('aria-current');
			});
		}
		let ticking = false;
		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					ticking = false;
					spy();
				});
			},
			{ passive: true, signal },
		);
		spy();
	});
</script>
