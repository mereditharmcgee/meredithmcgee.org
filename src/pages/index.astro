---
import BaseHead from '../components/BaseHead.astro';
import EmberClick from '../components/EmberClick.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SubstackFeed from '../components/SubstackFeed.astro';
import TypewriterRoles from '../components/TypewriterRoles.astro';
import VineFrame from '../components/VineFrame.astro';
import Interests from '../components/Interests.astro';
import WorkCard from '../components/WorkCard.astro';
import { work } from '../data/work';
import { SITE_TITLE, SUBSTACK_URL } from '../consts';

const featuredWork = work.filter((item) => item.featured).slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description="Meredith McGee is a public health writer, evaluator, and researcher based in Boston." />
	</head>
	<body>
		<Header />

		<!-- Beat 1: Hero -->
		<section class="hero bg-dark bg-pattern">
			<div class="container hero-grid">
				<div class="hero-text">
					<h1>Meredith McGee</h1>
					<div class="hero-roles">
						<TypewriterRoles />
					</div>
				</div>
				<div class="hero-photo-wrap">
					<VineFrame><img src="/meredith-headshot.jpg" alt="Meredith McGee" class="hero-photo" /></VineFrame>
				</div>
			</div>
		</section>

		<!-- Beat 2: Bio -->
		<section class="bio bg-medium">
			<div class="container animate-on-scroll">
				<p class="bio-copy">I'm Meredith. I'm deeply curious about systems and what happens when they fall short. That curiosity has taken me a lot of places: <span class="footnote-trigger" tabindex="0" role="button" data-aside="At Lafayette, K and I co-founded OUT Lafayette and launched Lavender Lane, the college's first gender-affirming housing. We also brought panels of the National AIDS Memorial Quilt to campus for the first time in three decades.">reviving LGBTQ+ programming</span> and building the first gender-inclusive housing at my college, <span class="footnote-trigger" tabindex="0" role="button" data-aside="I genuinely like writing grants, which I realize sounds unhinged. But there's something satisfying about building an argument for why something deserves to exist.">writing grants that have funded over a million dollars</span> in health equity and community programs, researching LGBTQ+ mental health at Yale, studying how people actually experience <span class="footnote-trigger" tabindex="0" role="button" data-aside="The drug policy parabola: both prohibition and unregulated commercial markets cause harm. The best policy lives somewhere between them. My research at Parabola Center focuses on what that middle ground looks like in practice.">legal cannabis markets</span>, and occasionally <span class="footnote-trigger" tabindex="0" role="button" data-aside="You're on one right now, but the bigger one is RateMyPlace, a tenant review platform I built from scratch because renters deserve better data about where they live.">making things on the internet</span>. The thread that connects all of it is trying to make public health make sense to the people it's supposed to serve.</p>
				<p class="bio-copy">Right now I'm in Boston, publishing <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer">Ground Level</a> (a Substack about cannabis, public health, and the gap between policy and practice), building <a href="https://ratemyplace.org" target="_blank" rel="noopener noreferrer">RateMyPlace</a> (a tenant review platform grounded in public health research), doing research at <a href="https://www.parabolacenter.com" target="_blank" rel="noopener noreferrer">Parabola Center for Law and Policy</a>, and writing grants at <a href="https://www.bradburysullivancenter.org/" target="_blank" rel="noopener noreferrer">Bradbury-Sullivan LGBT Community Center</a>. I live with my partner K and a black lab named <span class="ember-trigger" tabindex="0" role="button" aria-label="Click to meet Ember">Ember</span> who is scientifically proven to reduce my stress.</p>
			</div>
		</section>

		<!-- Beat 3: What I'm Working On -->
		<section class="working-on bg-dark">
			<div class="container">
				<h2 class="animate-on-scroll">What I'm working on</h2>
				<p class="section-intro animate-on-scroll">The latest from <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer">Ground Level</a>, where I write about cannabis, public health, and the gap between policy and practice.</p>
				<SubstackFeed limit={3} />
			</div>
		</section>

		<!-- Beat 3.5: Selected Work -->
		<section class="selected-work bg-dark">
			<div class="container">
				<h2 class="animate-on-scroll">Selected work</h2>
				<p class="section-intro animate-on-scroll">A few things I've made and done. You'll find the rest on the <a href="/work">work page</a>.</p>
				<div class="selected-work__list animate-on-scroll">
					{featuredWork.map((item) => <WorkCard {...item} />)}
				</div>
				<div class="selected-work__more animate-on-scroll">
					<a href="/work">See all work &rarr;</a>
				</div>
			</div>
		</section>

		<!-- Beat 4: Things I Think About -->
		<Interests />

		<!-- Footnote tooltip (shared for bio asides) -->
		<div id="footnote-tooltip" class="footnote-tooltip" role="tooltip" aria-hidden="true">
			<p class="footnote-text"></p>
		</div>

		<EmberClick />
		<Footer />
	</body>
</html>

<style>
	/* ==================== Hero ==================== */
	.hero {
		padding-top: 6rem;
		padding-bottom: 4rem;
	}

	.hero-grid {
		max-width: 900px;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 3rem;
		align-items: center;
	}

	.hero-text h1 {
		font-size: clamp(2.2rem, 4.5vw, 3.5rem);
		margin-bottom: 0.25rem;
		line-height: 1.1;
	}

	.hero-roles {
		font-size: clamp(1.2rem, 2.5vw, 1.6rem);
		min-height: 1.5em;
	}

	.hero-photo-wrap {
		position: relative;
	}

	.hero-photo {
		display: block;
		width: 280px;
		height: 340px;
		object-fit: cover;
		border-radius: 16px;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
		border: 3px solid rgba(212, 185, 104, 0.25);
		transition: border-color 0.4s ease;
	}

	.hero-photo:hover {
		border-color: rgba(212, 185, 104, 0.5);
	}

	/* ==================== Bio ==================== */
	.bio {
		padding: 4rem 0;
	}

	.bio .container {
		max-width: 800px;
	}

	.bio-copy {
		font-size: clamp(0.95rem, 1.1vw, 1.08rem);
		line-height: 1.85;
		margin-bottom: 1.5rem;
	}

	.bio-copy:last-child {
		margin-bottom: 0;
	}

	.bio-copy a {
		color: var(--color-gold);
		text-decoration: underline;
		text-underline-offset: 0.15em;
		text-decoration-thickness: 1px;
		transition: color 0.3s ease;
	}

	.bio-copy a:hover {
		color: var(--color-cream);
	}

	/* Footnote triggers (same dotted style as About page) */
	:global(.footnote-trigger) {
		border-bottom: 1.5px dotted var(--color-gold);
		cursor: pointer;
		touch-action: manipulation;
		transition: border-bottom-color 0.2s ease;
	}

	:global(.footnote-trigger:hover) {
		border-bottom-color: var(--color-cream);
	}

	:global(.footnote-trigger:focus-visible) {
		outline: 2px solid var(--color-gold);
		outline-offset: 2px;
		border-radius: 2px;
	}

	/* Footnote tooltip */
	.footnote-tooltip {
		position: fixed;
		max-width: 300px;
		padding: 0.85rem 1.1rem;
		background: var(--color-dark);
		border: 1px solid var(--color-gold);
		border-radius: 10px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
		z-index: 1001;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	.footnote-tooltip.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.footnote-tooltip .footnote-text {
		color: var(--color-cream);
		font-size: 0.875rem;
		line-height: 1.55;
		font-style: italic;
		margin: 0;
	}

	/* ==================== Working On ==================== */
	.working-on {
		padding: 5rem 0;
	}

	.working-on .container {
		max-width: 800px;
	}

	.working-on h2 {
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		margin-bottom: 0.75rem;
		text-align: center;
	}

	.section-intro {
		text-align: center;
		font-size: 0.95rem;
		color: var(--color-text-muted);
		margin-bottom: 2.5rem;
		line-height: 1.6;
	}

	.section-intro a {
		color: var(--color-gold);
		text-decoration: underline;
		text-underline-offset: 0.15em;
		text-decoration-thickness: 1px;
	}

	.section-intro a:hover {
		color: var(--color-cream);
	}

	/* ==================== Selected Work ==================== */
	.selected-work .container {
		max-width: 800px;
	}

	.selected-work h2 {
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		margin-bottom: 0.75rem;
		text-align: center;
	}

	.selected-work__list {
		border-top: 2px solid var(--color-gold);
		padding-top: 0.5rem;
		margin-top: 1.5rem;
	}

	.selected-work__more {
		margin-top: 2rem;
		text-align: center;
	}

	.selected-work__more a {
		font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
		font-size: 0.95rem;
		color: var(--color-gold);
		text-decoration: none;
		letter-spacing: 0.02em;
		transition: color 0.2s ease;
	}

	.selected-work__more a:hover {
		color: var(--color-cream);
	}

	/* ==================== Mobile ==================== */
	@media (max-width: 768px) {
		.hero {
			padding-top: 5rem;
		}

		.hero-grid {
			grid-template-columns: 1fr;
			text-align: center;
			gap: 2rem;
		}

		.hero-text h1 {
			text-align: center;
		}

		.hero-roles {
			justify-content: center;
			display: flex;
		}

		.hero-photo-wrap {
			order: -1;
		}

		.hero-photo {
			width: 220px;
			height: 270px;
			margin: 0 auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footnote-tooltip {
			transition: none;
		}
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		// --- Footnote tooltip logic ---
		const tooltip = document.getElementById('footnote-tooltip');
		const tooltipText = tooltip?.querySelector('.footnote-text');
		if (!tooltip || !tooltipText) return;

		const triggers = document.querySelectorAll('.footnote-trigger');
		if (triggers.length === 0) return;

		triggers.forEach(trigger => {
			trigger.addEventListener('click', (e) => {
				e.stopPropagation();
				const aside = trigger.getAttribute('data-aside');
				if (!aside) return;

				tooltipText.textContent = aside;

				const TOOLTIP_WIDTH = 300;
				const x = Math.min(e.clientX + 10, window.innerWidth - TOOLTIP_WIDTH - 15);
				const y = Math.max(e.clientY - 80, 80);
				tooltip.style.left = `${x}px`;
				tooltip.style.top = `${y}px`;

				tooltip.classList.add('visible');
				tooltip.setAttribute('aria-hidden', 'false');
			});

			trigger.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					trigger.click();
				}
			});
		});

		document.addEventListener('click', () => {
			tooltip.classList.remove('visible');
			tooltip.setAttribute('aria-hidden', 'true');
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				tooltip.classList.remove('visible');
				tooltip.setAttribute('aria-hidden', 'true');
			}
		});
	});
</script>
