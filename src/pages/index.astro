---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SubstackFeed from '../components/SubstackFeed.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE_TITLE } from '../consts';
import { work } from '../data/work';

const featuredWork = work.filter(item => item.featured);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description="Public health writer, evaluator, and researcher based in Boston." />
	</head>
	<body>
		<Header />

		<!-- Beat 1: Intro -->
		<section class="intro bg-dark bg-pattern">
			<div class="container animate-on-scroll">
				<h1>Meredith McGee</h1>
				<img src="/meredith-headshot.jpg" alt="Meredith McGee" class="hero-photo" />
				<p class="intro-copy">I'm Meredith. I'm deeply curious about systems and what happens when they fall short. That curiosity has taken me a lot of places: reviving LGBTQ+ programming and building the first gender-inclusive housing at my college, writing grants that have funded over a million dollars in health equity and community programs, researching LGBTQ+ mental health at Yale, studying how people actually experience legal cannabis markets, and occasionally building weird things on the internet. The thread that connects all of it is trying to make public health make sense to the people it's supposed to serve. Right now I'm in Boston, publishing Ground Level (a Substack about cannabis, public health, and the gap between policy and practice), doing research at Parabola Center for Law and Policy, and writing grants at Bradbury-Sullivan LGBT Community Center. I live with my partner K and a black lab named Ember who is scientifically proven to reduce my stress.</p>
			</div>
		</section>

		<!-- Beat 2: What I'm Working On -->
		<section class="working-on bg-medium">
			<div class="container">
				<h2 class="animate-on-scroll">What I'm working on</h2>
				<SubstackFeed limit={3} />
			</div>
		</section>

		<!-- Beat 3: Selected Work -->
		<section class="selected-work bg-dark">
			<div class="container">
				<h2 class="animate-on-scroll">Selected work</h2>
				{featuredWork.map(item => (
					<WorkCard
						title={item.title}
						description={item.description}
						category={item.category}
						link={item.link}
					/>
				))}
				<div class="see-more">
					<a href="/work">See all work &rarr;</a>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	/* Beat 1: Intro */
	.intro {
		padding-top: 6rem;
		padding-bottom: 4rem;
	}

	.intro .container {
		max-width: 800px;
		padding: 0 2rem;
	}

	.intro h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1.5rem;
		text-align: center;
	}

	.hero-photo {
		display: block;
		margin: 0 auto 2rem auto;
		max-width: 350px;
		width: 100%;
		height: auto;
		border-radius: 12px;
		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
		border: 3px solid var(--color-medium);
	}

	.intro-copy {
		font-size: clamp(0.95rem, 1.1vw, 1.1rem);
		line-height: 1.8;
		text-align: left;
		max-width: 700px;
		margin: 0 auto;
	}

	/* Beat 2: Working On */
	.working-on {
		padding: 5rem 0;
	}

	.working-on .container {
		max-width: 800px;
		padding: 0 2rem;
	}

	.working-on h2 {
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		margin-bottom: 1.5rem;
		text-align: center;
	}

	/* Beat 3: Selected Work */
	.selected-work {
		padding: 5rem 0;
	}

	.selected-work .container {
		max-width: 800px;
		padding: 0 2rem;
	}

	.selected-work h2 {
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		margin-bottom: 1.5rem;
		text-align: center;
	}

	.see-more {
		margin-top: 2rem;
		text-align: center;
	}

	.see-more a {
		font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
		font-size: 0.95rem;
		color: var(--color-gold);
		text-decoration: none;
		letter-spacing: 0.02em;
		transition: color 0.2s ease;
	}

	.see-more a:hover {
		color: var(--color-cream);
	}

	/* Mobile */
	@media (max-width: 768px) {
		.intro {
			padding-top: 5rem;
		}

		.hero-photo {
			max-width: 280px;
		}
	}
</style>
