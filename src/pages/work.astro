---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE_TITLE } from '../consts';
import { work } from '../data/work';

const featuredWork = work.filter(item => item.featured);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Work | ${SITE_TITLE}`} description="Research, writing, grants, and evaluation work from Meredith McGee. Here's what that looks like in practice." />
	</head>
	<body>
		<Header />

		<section class="work-hero bg-dark bg-pattern">
			<div class="container animate-on-scroll">
				<h1>Work</h1>
				<p class="hero-intro">
					I work at the intersection of public health, writing, and research. Some of it's published, some of it helped organizations get funded, and some of it lives in reports that made their way to decision-makers. Here's what that looks like in practice.
				</p>
			</div>
		</section>

		<section class="work-list bg-dark">
			<div class="container">
				{featuredWork.map(item => (
					<WorkCard
						title={item.title}
						description={item.description}
						category={item.category}
						link={item.link}
					/>
				))}

				<div class="archive-link">
					<a href="/work/archive">See all work &rarr;</a>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	.work-hero {
		padding-top: 5rem;
		padding-bottom: 3.5rem;
		text-align: center;
	}

	.work-hero .container {
		max-width: 800px;
		padding: 0 2rem;
	}

	.work-hero h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}

	.hero-intro {
		font-size: clamp(0.95rem, 1.1vw, 1.1rem);
		line-height: 1.8;
		opacity: 0.95;
	}

	.work-list {
		padding: 4rem 0 5rem;
	}

	.work-list .container {
		max-width: 800px;
		padding: 0 2rem;
	}

	.archive-link {
		margin-top: 2rem;
		text-align: center;
	}

	.archive-link a {
		font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
		font-size: 0.95rem;
		color: var(--color-gold);
		text-decoration: none;
		letter-spacing: 0.02em;
		transition: color 0.2s ease;
	}

	.archive-link a:hover {
		color: var(--color-cream);
	}

	@media (max-width: 768px) {
		.work-hero {
			padding-top: 4rem;
		}
	}
</style>
