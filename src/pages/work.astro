---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE_TITLE } from '../consts';
import { work } from '../data/work';

const order = ['RESEARCH', 'PROJECTS', 'WRITING', 'GRANTS', 'EVALUATION', 'TOOLS', 'POLICY'];
const labels: Record<string, string> = {
	RESEARCH: 'Research',
	PROJECTS: 'Building',
	WRITING: 'Writing',
	GRANTS: 'Grants',
	EVALUATION: 'Evaluation',
	TOOLS: 'Tools',
	POLICY: 'Policy',
};
const cats = order.filter((c) => work.some((w) => w.category === c));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Work | ${SITE_TITLE}`} description="Research, building, writing, and grants from Meredith McGee. Here's what that looks like in practice." />
	</head>
	<body>
		<Header />

		<section class="work-hero bg-dark bg-pattern">
			<div class="container animate-on-scroll">
				<h1>Work</h1>
				<p class="hero-intro">
					I study how systems fail the people they're supposed to serve, I write about it publicly, and I build tools to close the gap. Here's what that looks like in practice. Filter by the kind of work, or just scroll.
				</p>
			</div>
		</section>

		<ProjectGallery />

		<section class="work-list bg-dark">
			<div class="container">
				<div class="work-list-head">
					<p class="work-list-kicker">The full record</p>
					<h2 class="work-list-title">Everything, filterable</h2>
				</div>

				<div class="work-filters" aria-label="Filter work by type">
					<button class="work-filter is-active" data-filter="all" type="button">All</button>
					{cats.map((c) => (
						<button class="work-filter" data-filter={c} type="button">{labels[c] || c}</button>
					))}
				</div>

				<div class="work-items">
					{work.map((item) => <WorkCard {...item} />)}
				</div>

				<p class="work-empty" hidden>Nothing in that category yet.</p>
			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	.work-hero {
		padding-top: 5rem;
		padding-bottom: 3.5rem;
		text-align: center;
	}

	.work-hero .container {
		max-width: 800px;
		padding: 0 2rem;
	}

	.work-hero h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}

	.hero-intro {
		font-size: clamp(0.95rem, 1.1vw, 1.1rem);
		line-height: 1.8;
		opacity: 0.95;
	}

	.work-list {
		padding: 3rem 0 5rem;
	}

	.work-list .container {
		max-width: 800px;
		padding: 0 2rem;
	}

	.work-list-head {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.work-list-kicker {
		font-size: 0.74rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-gold);
		font-weight: 600;
		margin-bottom: 0.4rem;
	}

	.work-list-title {
		font-size: clamp(1.6rem, 3vw, 2.1rem);
	}

	.work-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: center;
		margin-bottom: 2.25rem;
	}

	.work-filter {
		font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
		font-size: 0.8rem;
		letter-spacing: 0.03em;
		color: var(--color-cream);
		background: transparent;
		border: 1px solid rgba(212, 201, 142, 0.25);
		border-radius: 20px;
		padding: 0.35rem 0.9rem;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.work-filter:hover {
		border-color: var(--color-gold);
		color: var(--color-gold);
	}

	.work-filter.is-active {
		background: var(--color-gold);
		border-color: var(--color-gold);
		color: var(--color-dark);
		font-weight: 600;
	}

	:global(.work-card.is-hidden) {
		display: none;
	}

	.work-empty {
		text-align: center;
		color: var(--color-text-muted);
		font-size: 0.95rem;
		padding: 2rem 0;
	}

	@media (max-width: 768px) {
		.work-hero {
			padding-top: 4rem;
		}
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		const filters = Array.from(document.querySelectorAll('.work-filter'));
		const cards = Array.from(document.querySelectorAll('.work-items .work-card'));
		const empty = document.querySelector('.work-empty') as HTMLElement | null;
		if (filters.length === 0) return;

		filters.forEach((btn) => {
			btn.addEventListener('click', () => {
				filters.forEach((b) => b.classList.remove('is-active'));
				btn.classList.add('is-active');

				const f = btn.getAttribute('data-filter');
				let shown = 0;
				cards.forEach((card) => {
					const match = f === 'all' || card.getAttribute('data-category') === f;
					card.classList.toggle('is-hidden', !match);
					if (match) shown++;
				});
				if (empty) empty.hidden = shown !== 0;
			});
		});
	});
</script>
