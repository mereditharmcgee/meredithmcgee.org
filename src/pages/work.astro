---
// The Work page. The headline is the filter: pressing a verb shows only that
// kind of work, pressing it again shows everything.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { projects } from '../data/projects';
import { work } from '../data/work';
import '../styles/pages.css';

// Wording for this page. Change it here.
const FILTER_LABEL = 'Filter the work by what I do';
const HEADLINE = { before: 'Show me what I', and: ' and ' };
const SHOW_ALL = 'Or show everything';
const CASES = { label: 'Case studies', heading: 'The long version', link: 'Read the case study' };
const PROJECTS = {
	label: 'The work itself',
	heading: 'Selected work, up close',
	intro: 'The actual decks, posters, and prospectuses behind the work. Each one opens as a full PDF you can page through.',
};
const RECORD = { label: 'The full record', heading: 'Everything else' };

const verbs = ['study', 'write', 'build', 'fund'] as const;
const cases = work.filter((item) => item.slug);
const others = work.filter((item) => !item.slug);

// PROJECTS becomes Projects, and so on.
const label = (category: string) => category.charAt(0) + category.slice(1).toLowerCase();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Work | ${SITE_TITLE}`} description="Research, building, writing, and grants from Meredith McGee. Here's what that looks like in practice." />
	</head>
	<body>
		<Header />
		<main id="main">
			<header class="phero p-plain">
				<div class="wrap phero-in">
					<div class="phero-text">
						<p class="label">Work</p>
						<h1 class="phero-h vfilter" role="group" aria-label={FILTER_LABEL}>
							{HEADLINE.before}{verbs.map((v, i) => (
								<Fragment>{i === verbs.length - 1 ? HEADLINE.and : ' '}<span class="nw"><button type="button" class={`vf v-${v}`} data-vf={v} aria-pressed="false">{v}</button>{i === verbs.length - 1 ? '.' : ','}</span></Fragment>
							))}
						</h1>
						<p class="vf-all-row"><button type="button" class="vf-all" data-vf="all" aria-pressed="true">{SHOW_ALL}</button></p>
					</div>
				</div>
			</header>

			<section class="wrap sec stack vsec">
				<div>
					<p class="label">{CASES.label}</p>
					<h2 class="h2">{CASES.heading}</h2>
				</div>
				<div class="casecards">
					{cases.map((item) => (
						<article class={`casecard vb-${item.verb}`} data-verb={item.verb}>
							<a class="casecard-vis" href={`/work/${item.slug}`} tabindex="-1" aria-hidden="true">
								{item.card?.kind === 'image' && (
									<span class:list={['pic', { cover: item.card.cover }]}><img src={item.card.src} alt="" width={item.card.width} height={item.card.height} loading="lazy" /></span>
								)}
								{item.card?.kind === 'stat' && (<span class="pic stattile"><span class="stat xl">{item.card.value}</span></span>)}
							</a>
							<p class="label vc">{label(item.category)}</p>
							<h3 class="h3"><a href={`/work/${item.slug}`}>{item.title}</a></h3>
							<p class="card-text">{item.summary}</p>
							<a class="go" href={`/work/${item.slug}`}>{CASES.link} <span aria-hidden="true">→</span></a>
						</article>
					))}
				</div>
			</section>

			<section class="band vsec">
				<div class="wrap sec stack">
					<div>
						<p class="label">{PROJECTS.label}</p>
						<h2 class="h2">{PROJECTS.heading}</h2>
					</div>
					<p class="measure">{PROJECTS.intro}</p>
					<div class="projs">
						{projects.map((p) => (
							<article class={`proj vb-${p.verb}`} data-verb={p.verb}>
								<a class="proj-thumb" href={p.pdf} target="_blank" rel="noopener"><img src={p.thumb.src} alt={p.coverAlt} width={p.thumb.width} height={p.thumb.height} loading="lazy" /></a>
								<p class="label vc">{p.tag} <span class="role">{p.format}</span></p>
								<h3 class="h4">{p.title}</h3>
								<p class="caption">{p.role}</p>
								<p class="card-text">{p.desc}</p>
								<a class="go" href={p.pdf} target="_blank" rel="noopener">{p.cta} <span aria-hidden="true">↗</span></a>
								{p.also && (<a class="also" href={p.also.href} target="_blank" rel="noopener">{p.also.label} <span aria-hidden="true">→</span></a>)}
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="wrap sec stack vsec">
				<div>
					<p class="label">{RECORD.label}</p>
					<h2 class="h2">{RECORD.heading}</h2>
				</div>
				<div class="cards two" id="work-items">
					{others.map((item) => (
						<article class={`card vb-${item.verb}`} data-verb={item.verb}>
							<p class="label vc">{label(item.category)}{item.role && (<Fragment>{' '}<span class="role">{item.role}</span></Fragment>)}</p>
							<h3 class="h3">{item.title}</h3>
							<p class="card-text">{item.description}</p>
							{item.href && (<a class="go" href={item.href} target="_blank" rel="noopener">{item.linkLabel} <span aria-hidden="true">↗</span></a>)}
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	// The verb filter. A section with nothing left to show hides too.
	import { onPage } from '../scripts/page';

	onPage((signal) => {
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-vf]'));
		const items = Array.from(document.querySelectorAll<HTMLElement>('main [data-verb]'));
		const sections = Array.from(document.querySelectorAll<HTMLElement>('main .vsec'));

		function show(verb: string) {
			buttons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.vf === verb ? 'true' : 'false'));
			items.forEach((item) => (item.hidden = !(verb === 'all' || item.dataset.verb === verb)));
			sections.forEach((s) => (s.hidden = !Array.from(s.querySelectorAll<HTMLElement>('[data-verb]')).some((item) => !item.hidden)));
		}

		buttons.forEach((b) =>
			b.addEventListener(
				'click',
				() => {
					const verb = b.dataset.vf || 'all';
					show(b.getAttribute('aria-pressed') === 'true' && verb !== 'all' ? 'all' : verb);
				},
				{ signal },
			),
		);
	});
</script>
