---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`AI Social Norms Observatory | ${SITE_TITLE}`} description="A short study of how people judge specific uses of AI: ten situations, four questions each, your own results at the end." />
	</head>
	<body>
		<Header />

		<section class="contact-hero bg-dark bg-pattern">
			<div class="container animate-on-scroll">
				<h1>AI Social Norms Observatory</h1>
			</div>
		</section>

		<section class="contact-content bg-medium">
			<div class="container animate-on-scroll">
				<p class="intro-text">
					A study of how people judge specific uses of AI. You read ten short situations and rate each one on four questions. It takes about 8 to 12 minutes, every question can be skipped, and you see a summary of your own answers at the end.
				</p>

				<p class="intro-text">
					It is independent, anonymous, and for adults. I run it myself; it is not affiliated with any institution, and the consent page says exactly what is collected and what is not.
				</p>

				<p class="email-display">
					<a href="https://study.meredithmcgee.org/">Take part in the study</a>
				</p>

				<p class="social-links">
					Questions: <a href="mailto:meredith.ar.mcgee@gmail.com">meredith.ar.mcgee@gmail.com</a>.
				</p>
			</div>
		</section>

		<Footer />
	</body>
</html>
