---
// The AI Social Norms Observatory page. It is set aside, not deleted: the
// address keeps working, but nothing on the site links to it and it is left
// out of the sitemap (see astro.config.mjs).
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CONTACT_EMAIL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`AI Social Norms Observatory | ${SITE_TITLE}`} description="A short study of how people judge specific uses of AI: ten situations, four questions each, your own results at the end." />
	</head>
	<body>
		<Header />
		<main id="main">
			<header class="wrap page-head">
				<h1 class="page-h">AI Social Norms Observatory</h1>
			</header>
			<section class="wrap sec stack narrow">
				<p class="body-lg">
					A study of how people judge specific uses of AI. You read ten short situations and rate each one on four questions. It takes about 8 to 12 minutes, every question can be skipped, and you see a summary of your own answers at the end.
				</p>
				<p class="body-lg">
					It is independent, anonymous, and for adults. I run it myself; it is not affiliated with any institution, and the consent page says exactly what is collected and what is not.
				</p>
				<p class="cta"><a class="btn solid" href="https://study.meredithmcgee.org/">Take part in the study</a></p>
				<p>Questions: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
