---
// The Contact page. The form posts straight to its Formspree form.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CONTACT_EMAIL, CONTACT_FORM_ENDPOINT, LINKEDIN_URL, SITE_TITLE, SUBSTACK_URL } from '../consts';
import '../styles/pages.css';

// The line that points organizations to Work with me. Change the wording here.
const CLIENTS_LINE = 'If you run an organization and you’re trying to figure out how to fund it, I do that work too.';
const CLIENTS_LINK = 'Here’s how I work with clients.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description="Get in touch with Meredith McGee. I'd love to hear from you." />
	</head>
	<body>
		<Header />
		<main id="main">
			<header class="phero p-plain">
				<div class="wrap phero-in">
					<div class="phero-text">
						<p class="label">Contact</p>
						<h1 class="phero-h">Say hello</h1>
						<p class="lede">I’d love to hear from you. Whether it’s about public health, writing, community work, or something I haven’t thought of yet, I’m always up for a good conversation.</p>
					</div>
					<div class="phero-side">
						<figure class="ember">
							<img src="/img/ember.webp" alt="Ember, a black lab in a purple harness" width="440" height="707" />
						</figure>
					</div>
				</div>
			</header>
			<section class="wrap sec split">
				<div class="stack">
					<p class="body-lg">I’m especially glad to talk with people building work that puts rigorous research and public writing in the same place. That’s the direction I’m headed, so if it’s yours too, say hello.</p>
					<p class="body-lg">{CLIENTS_LINE}<br /><a href="/work-with-me">{CLIENTS_LINK}</a></p>
					<p class="reach"><span class="email">{CONTACT_EMAIL}</span></p>
					<p>You can also find me on <a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a> and <a href={SUBSTACK_URL} target="_blank" rel="noopener">Substack</a>. If you’d rather see the formal version, here’s my <a href="/Meredith-McGee-CV.pdf" target="_blank" rel="noopener">CV</a>.</p>
				</div>
				<div>
					<form class="form" id="contact-form" method="POST" action={CONTACT_FORM_ENDPOINT}>
						<label for="cf-name">Name</label>
						<input id="cf-name" name="name" type="text" autocomplete="name" required />
						<label for="cf-email">Email</label>
						<input id="cf-email" name="email" type="email" autocomplete="email" required />
						<label for="cf-msg">Message</label>
						<textarea id="cf-msg" name="message" rows="5" placeholder="What's on your mind?" required></textarea>
						<div><button class="btn solid" type="submit">Send Message</button></div>
					</form>
					<p class="caption form-after">I’ll get back to you as soon as I can.</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
