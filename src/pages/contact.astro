---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact | ${SITE_TITLE}`} description="Get in touch with Meredith McGee. I'd love to hear from you." />
	</head>
	<body>
		<Header />

		<!-- Hero Section -->
		<section class="contact-hero bg-dark bg-pattern">
			<div class="container animate-on-scroll">
				<h1>Say Hello</h1>
			</div>
		</section>

		<!-- Contact Content -->
		<section class="contact-content bg-light">
			<div class="container animate-on-scroll">

				<p class="intro-text">
					I'd love to hear from you. Whether it's about public health, writing, community work, or something I haven't thought of yet, I'm always up for a good conversation.
				</p>

				<p class="intro-text">
					You can reach me directly at:
				</p>

				<p class="email-display">
					<a href="mailto:meredith.ar.mcgee@gmail.com">meredith.ar.mcgee@gmail.com</a>
				</p>

				<p class="social-links">
					You can also find me on <a href="https://www.linkedin.com/in/meredith-mcgee">LinkedIn</a> and <a href="https://meredithmcgee.substack.com">Substack</a>.
				</p>

				<div class="contact-form-wrapper">
					<form action="https://formspree.io/f/xgooeagz" method="POST" class="contact-form">
						<div class="form-group">
							<label for="name">Name</label>
							<input type="text" id="name" name="name" required />
						</div>

						<div class="form-group">
							<label for="email">Email</label>
							<input type="email" id="email" name="email" required />
						</div>

						<div class="form-group">
							<label for="message">Message</label>
							<textarea id="message" name="message" rows="5" required placeholder="What's on your mind?"></textarea>
						</div>

						<button type="submit" class="btn submit-btn">Send Message</button>
					</form>
				</div>

				<p class="sign-off">I'll get back to you as soon as I can.</p>

			</div>
		</section>

		<Footer />
	</body>
</html>

<style>
	/* Hero Section */
	.contact-hero {
		padding-top: 5rem;
		padding-bottom: 3.5rem;
		text-align: center;
	}

	.contact-hero .container {
		max-width: 700px;
		padding: 0 2rem;
	}

	.contact-hero h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 0;
	}

	/* Contact Content */
	.contact-content {
		padding: 4rem 0 5rem;
	}

	.contact-content .container {
		max-width: 700px;
		padding: 0 2rem;
	}

	.intro-text {
		font-size: clamp(0.95rem, 1.1vw, 1.05rem);
		line-height: 1.8;
		color: var(--color-dark);
		margin-bottom: 1rem;
	}

	.email-display {
		margin: 1.5rem 0;
	}

	.email-display a {
		font-size: clamp(1rem, 1.3vw, 1.2rem);
		color: var(--color-medium);
		font-weight: 600;
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.email-display a:hover {
		color: var(--color-dark);
		text-decoration: underline;
	}

	.social-links {
		font-size: clamp(0.9rem, 1.05vw, 1rem);
		line-height: 1.7;
		color: var(--color-dark);
		margin-bottom: 2.5rem;
	}

	.social-links a {
		color: var(--color-medium);
		font-weight: 600;
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.social-links a:hover {
		color: var(--color-dark);
		text-decoration: underline;
	}

	/* Contact Form */
	.contact-form-wrapper {
		background: var(--color-dark);
		padding: 2rem;
		border-radius: 12px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
		margin-bottom: 1.5rem;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.form-group label {
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--color-gold);
	}

	.form-group input,
	.form-group textarea {
		padding: 0.75rem;
		border: 1px solid rgba(212, 201, 142, 0.3);
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.05);
		color: var(--color-cream);
		font-family: 'Source Sans 3', sans-serif;
		font-size: 0.9rem;
		transition: border-color 0.3s ease, background 0.3s ease;
	}

	.form-group input:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--color-gold);
		background: rgba(255, 255, 255, 0.08);
	}

	.form-group input::placeholder,
	.form-group textarea::placeholder {
		color: rgba(232, 228, 208, 0.5);
	}

	.form-group textarea {
		resize: vertical;
		min-height: 120px;
	}

	.submit-btn {
		margin-top: 0.5rem;
		background: var(--color-gold);
		color: var(--color-dark);
		border: 2px solid var(--color-gold);
		font-weight: 600;
		cursor: pointer;
	}

	.submit-btn:hover {
		background: transparent;
		color: var(--color-gold);
	}

	.sign-off {
		font-size: clamp(0.85rem, 1vw, 0.95rem);
		color: var(--color-medium);
		font-style: italic;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.contact-hero {
			padding-top: 4rem;
		}

		.contact-form-wrapper {
			padding: 1.5rem;
		}
	}
</style>
