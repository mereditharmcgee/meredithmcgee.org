---
// The full work archive. Nothing links here any more, but the address still
// works. It keeps its own simple layout with the site's fonts and tokens.
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import WorkCard from '../../components/WorkCard.astro';
import { SITE_TITLE } from '../../consts';
import { work } from '../../data/work';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Work Archive | ${SITE_TITLE}`} description="A complete list of selected projects, publications, and work from Meredith McGee." />
	</head>
	<body>
		<Header />
		<main id="main">
			<section class="archive-hero">
				<div class="archive-inner">
					<h1>Work Archive</h1>
					<p class="archive-intro">A complete list of selected projects and publications.</p>
				</div>
			</section>

			<section class="archive-list">
				<div class="archive-inner">
					{work.map((item) => (
						<WorkCard {...item} />
					))}

					<div class="back-link">
						<a href="/work">&larr; Back to Work</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.archive-inner {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.archive-hero {
		padding-top: 5rem;
		padding-bottom: 3.5rem;
		text-align: center;
	}

	.archive-hero h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: 1rem;
		color: var(--brand);
	}

	.archive-intro {
		font-size: clamp(0.95rem, 1.1vw, 1.1rem);
		line-height: 1.8;
		color: var(--tea-700);
	}

	.archive-list {
		padding: 4rem 0 5rem;
	}

	.back-link {
		margin-top: 2rem;
		text-align: center;
	}

	.back-link a {
		font-size: 0.95rem;
		font-weight: 700;
	}

	@media (max-width: 768px) {
		.archive-hero {
			padding-top: 4rem;
		}

		.archive-inner {
			padding: 0 1.5rem;
		}
	}
</style>
