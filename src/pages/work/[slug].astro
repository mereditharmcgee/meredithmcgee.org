---
// A case study page. Each one opens in its verb's color. The text comes from
// src/data/work.ts, and the legalization study adds its report block and
// findings from src/data/study.ts.
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import StudyFindings from '../../components/study/Findings.astro';
import StudyPeople from '../../components/study/People.astro';
import StudyPress from '../../components/study/Press.astro';
import StudyReport from '../../components/study/Report.astro';
import StudyTrio from '../../components/study/Trio.astro';
import { SITE_TITLE } from '../../consts';
import { work } from '../../data/work';
import '../../styles/pages.css';

export function getStaticPaths() {
	const cases = work.filter((item) => item.slug && item.caseStudy);
	return cases.map((item, i) => ({
		params: { slug: item.slug },
		props: { item, next: cases[(i + 1) % cases.length] },
	}));
}

// Wording shared by every case study. Change it here.
const BACK = 'Work';
const NEXT = 'Next';
const ALL_WORK = 'All work';
const WORK_WITH_ME = 'Work with me';
const LOGIC_MODEL_LINK = { label: 'See it as a logic model', href: '/how-i-work#logic-model' };

// The slug of the study that carries the report block and findings.
const STUDY = 'cannabis-legalization-study';

const { item, next } = Astro.props;
const { title, category, role, description, caseStudy, hero, slug, verb } = item;
const label = category.charAt(0) + category.slice(1).toLowerCase();
const isStudy = slug === STUDY;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main id="main">
			<header class={`phero p-${verb}`}>
				<div class="wrap phero-in">
					<div class="phero-text">
						<p><a class="more" href="/work"><span aria-hidden="true">←</span> {BACK}</a></p>
						<p class="label">{label} {role && <span class="role">{role}</span>}</p>
						<h1 class="phero-h sm">{title}</h1>
						<p class="lede">{caseStudy.lede}</p>
					</div>
					{hero?.kind === 'image' && (
						<div class="phero-side">
							<a class="pic frame" href={hero.href} target="_blank" rel="noopener"><img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} /></a>
						</div>
					)}
					{hero?.kind === 'stat' && (
						<div class="phero-side">
							<div class="bigstat">
								<p class="stat xxl">{hero.value}</p>
								<p class="caption">{hero.caption}</p>
							</div>
						</div>
					)}
				</div>
			</header>

			<article class="wrap case">
				{isStudy && (
					<div class="case-report">
						<StudyReport />
						<StudyTrio />
						<StudyPeople />
					</div>
				)}

				{caseStudy.sections.map((section) => (
					<section class="stack-s">
						<h2 class="h3">{section.heading}</h2>
						{section.paragraphs.map((p) => <p>{p}</p>)}
					</section>
				))}

				{isStudy && (
					<Fragment>
						<StudyFindings />
						<StudyPress />
					</Fragment>
				)}

				{verb === 'build' && item.href && (
					<p class="cta">
						<a class="btn" href={item.href} target="_blank" rel="noopener">{item.linkLabel} <span aria-hidden="true">↗</span></a>
						<a class="textlink" href={LOGIC_MODEL_LINK.href}>{LOGIC_MODEL_LINK.label}</a>
					</p>
				)}
				{verb === 'fund' && (
					<p class="cta"><a class="btn" href="/work-with-me">{WORK_WITH_ME}</a></p>
				)}

				<nav class="case-next" aria-label="More work">
					<a href={`/work/${next.slug}`}>
						<span class="label">{NEXT}</span>
						<span class="h4">{next.title}</span>
					</a>
					<a class="textlink" href="/work">{ALL_WORK}</a>
					<a class="textlink" href="/work-with-me">{WORK_WITH_ME}</a>
				</nav>
			</article>
		</main>
		<Footer />
	</body>
</html>
