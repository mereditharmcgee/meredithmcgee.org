---
// The Writing page. It grows on its own: Ground Level posts and Parabola
// Papers pieces come from their feeds at build time, and everything else is
// an entry in src/data/writing.ts.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SUBSTACK_URL } from '../consts';
import { write } from '../data/home';
import { clips } from '../data/writing';
import { coverFor } from '../lib/covers';
import { getGroundLevelPosts } from '../lib/groundLevel';
import { getParabolaPieces, PARABOLA_PAPERS } from '../lib/parabola';
import '../styles/pages.css';

// Wording for this page. Change it here.
const HEADLINE = 'I write for people outside the room where the decisions get made.';
const LEDE = 'Most of it is about cannabis and public health, and the widening gap between what the research shows and what policy actually does. Some of it runs in outlets, some of it runs on my own Substack.';
const IN_PRINT = { label: 'In print', heading: 'Published pieces', read: 'Read the piece' };
const GROUND_LEVEL = {
	heading: 'Ground Level',
	more: 'Read it on Substack',
	intro: 'My Substack about cannabis policy and public health: what the research actually shows, how legal markets are affecting the communities they were supposed to serve, and who is driving those decisions.',
	subscribe: 'Subscribe on Substack',
};
// How many Ground Level posts to show.
const POSTS = 6;

const lead = clips.find((c) => c.featured) ?? clips[0];

// Everything after the lead piece: the other entries in writing.ts plus her
// Parabola Papers pieces from the feed, newest first. A feed piece that is
// already an entry in writing.ts is not shown twice.
const listed = new Set(clips.map((c) => c.href));
const fromFeed = (await getParabolaPieces())
	.filter((p) => !listed.has(p.url))
	.map((p) => ({
		label: `${PARABOLA_PAPERS} · ${p.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'America/New_York' })}`,
		title: p.title,
		href: p.url,
		blurb: p.excerpt,
		when: p.date.getTime(),
	}));
const fromList = clips
	.filter((c) => c !== lead)
	.map((c) => ({ label: `${c.outlet} · ${c.kind} · ${c.date}`, title: c.title, href: c.href, blurb: c.blurb, when: new Date(c.date).getTime() || 0 }));
const pieces = [...fromFeed, ...fromList].sort((a, b) => b.when - a.when);

const groundLevel = await getGroundLevelPosts(POSTS, { covers: true });
const posts = groundLevel.posts.map((p) => ({
	...p,
	cover: coverFor(p),
	dateLabel: p.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/New_York' }),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing | ${SITE_TITLE}`} description="Published writing from Meredith McGee: op-eds and essays on cannabis, public health, and the gap between policy and practice, plus Ground Level, her Substack." />
	</head>
	<body>
		<Header />
		<main id="main">
			<header class="phero p-write">
				<div class="wrap phero-in">
					<div class="phero-text">
						<p class="label">Writing</p>
						<h1 class="phero-h sm">{HEADLINE}</h1>
						<p class="lede">{LEDE}</p>
					</div>
				</div>
			</header>

			<section class="wrap sec stack">
				<div>
					<p class="label">{IN_PRINT.label}</p>
					<h2 class="h2">{IN_PRINT.heading}</h2>
				</div>
				<article class="clip lead">
					<p class="label">{lead.outlet} · {lead.kind} · {lead.date}</p>
					<h3 class="clip-big"><a href={lead.href} target="_blank" rel="noopener">{lead.title}</a></h3>
					<p class="body-lg">{lead.blurb}</p>
					<a class="go" href={lead.href} target="_blank" rel="noopener">Read in {lead.outlet} <span aria-hidden="true">↗</span></a>
				</article>
				<div class="cards two">
					{pieces.map((piece) => (
						<article class="clip">
							<p class="label">{piece.label}</p>
							<h3 class="h3"><a href={piece.href} target="_blank" rel="noopener">{piece.title}</a></h3>
							<p class="card-text">{piece.blurb}</p>
							<a class="go" href={piece.href} target="_blank" rel="noopener">{IN_PRINT.read} <span aria-hidden="true">↗</span></a>
						</article>
					))}
				</div>
			</section>

			<section class="band" id="ground-level">
				<div class="wrap sec stack">
					<div class="sec-head">
						<h2 class="h2 gl-h"><img src="/img/brand/gl-avatar-96.png" alt="" width="36" height="36" loading="lazy" />{GROUND_LEVEL.heading}</h2>
						<a class="more" href={SUBSTACK_URL} target="_blank" rel="noopener">{GROUND_LEVEL.more}</a>
					</div>
					<p class="measure">{GROUND_LEVEL.intro}</p>
					{groundLevel.stale || posts.length === 0 ? (
						<p><a class="textlink" href={SUBSTACK_URL} target="_blank" rel="noopener">{write.staleLink} <span aria-hidden="true">↗</span></a></p>
					) : (
						<div class="picgrid">
							{posts.map((post) => (
								<article class="postpic">
									{post.cover ? (
										<Fragment>
											<a class="pic" href={post.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><img src={post.cover} alt="" width="800" height="450" loading="lazy" /></a>
											<p class="label">{post.dateLabel}</p>
											<h3 class="h4"><a href={post.url} target="_blank" rel="noopener">{post.title}</a></h3>
										</Fragment>
									) : (
										<Fragment>
											<h3 class="titlecard"><a href={post.url} target="_blank" rel="noopener">{post.title}</a></h3>
											<p class="label">{post.dateLabel}</p>
										</Fragment>
									)}
									<p class="card-text">{post.excerpt}</p>
								</article>
							))}
						</div>
					)}
					<p class="cta"><a class="btn" href={SUBSTACK_URL} target="_blank" rel="noopener">{GROUND_LEVEL.subscribe}</a></p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
