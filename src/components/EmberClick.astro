---
// EmberClick.astro
// Self-contained Ember click Easter egg component.
// Import once per page that contains "Ember" mentions.
---

<div id="ember-overlay" aria-hidden="true">
  <div class="ember-popup">
    <img src="" alt="Ember, Meredith's black lab" id="ember-photo" />
    <p class="ember-caption" id="ember-caption"></p>
  </div>
</div>

<style>
  /* .ember-trigger styles use :global() since those spans live in page files */
  :global(.ember-trigger) {
    border-bottom: 1.5px dotted var(--color-gold);
    cursor: pointer;
    touch-action: manipulation;
    color: inherit;
    transition: border-bottom-color 0.2s ease;
    display: inline;
  }

  :global(.ember-trigger:hover) {
    border-bottom-color: var(--color-cream);
  }

  :global(.ember-trigger:focus-visible) {
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
    border-radius: 2px;
  }

  #ember-overlay {
    position: fixed;
    inset: 0;
    z-index: 1001;
    pointer-events: none;
    display: none;
  }

  #ember-overlay.active {
    display: block;
    pointer-events: auto;
    background: rgba(45, 58, 30, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: overlayFadeIn 0.25s ease forwards;
  }

  .ember-popup {
    position: fixed;
    width: 240px;
    height: 240px;
    border-radius: 16px;
    overflow: hidden;
    pointer-events: auto;
    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(212, 185, 104, 0.3);
    border: 2.5px solid var(--color-gold);
    z-index: 1002;
    opacity: 0;
    transform: scale(0.8);
    transition: none;
  }

  .ember-popup.entering {
    animation: emberEnter 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .ember-popup img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ember-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(45, 58, 30, 0.9));
    color: var(--color-gold);
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 0.85rem;
    font-style: italic;
    padding: 1.5rem 0.75rem 0.5rem;
    text-align: center;
    margin: 0;
    display: none;
  }

  :global(.ember-particle) {
    position: fixed;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
    pointer-events: none;
    z-index: 1002;
    animation: particleBurst 0.8s ease-out forwards;
  }

  @keyframes overlayFadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes emberEnter {
    0% {
      opacity: 0;
      transform: scale(0.7);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes particleBurst {
    0% {
      opacity: 1;
      transform: translate(0, 0) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) scale(0.3);
    }
  }

  @keyframes floatDismiss {
    0% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    100% {
      opacity: 0;
      transform: scale(0.9) translateY(-30px);
    }
  }

  .ember-popup.dismissing {
    animation: floatDismiss 0.5s ease-in forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.ember-particle) {
      animation: none;
      opacity: 0;
    }

    #ember-overlay.active {
      animation: none;
    }

    .ember-popup.entering {
      animation: none;
      opacity: 1;
      transform: scale(1);
    }

    .ember-popup.dismissing {
      animation: none;
      display: none;
    }
  }
</style>

<script>
  function initEmberClick() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let emberClickCount = 0;
    let dismissTimer: ReturnType<typeof setTimeout> | null = null;

    const triggers = document.querySelectorAll('.ember-trigger');
    if (triggers.length === 0) return;

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e: Event) => {
        emberClickCount += 1;
        const isSilly = emberClickCount >= 3;
        const mouseEvent = e as MouseEvent;
        showEmberPopup(mouseEvent.clientX, mouseEvent.clientY, isSilly);
      });

      // Keyboard accessibility: trigger on Enter/Space like a button
      trigger.addEventListener('keydown', (e: Event) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault();
          emberClickCount += 1;
          const isSilly = emberClickCount >= 3;
          const rect = (trigger as HTMLElement).getBoundingClientRect();
          showEmberPopup(rect.left + rect.width / 2, rect.top + rect.height / 2, isSilly);
        }
      });
    });

    function showEmberPopup(x: number, y: number, isSilly: boolean) {
      // Clear any existing dismiss timer
      if (dismissTimer !== null) {
        clearTimeout(dismissTimer);
        dismissTimer = null;
      }

      // Fast-click particle protection: remove excess particles
      const existingParticles = document.querySelectorAll('.ember-particle');
      if (existingParticles.length > 30) {
        existingParticles.forEach((p) => p.remove());
      }

      const overlay = document.getElementById('ember-overlay') as HTMLElement | null;
      const popup = overlay?.querySelector('.ember-popup') as HTMLElement | null;
      const photo = document.getElementById('ember-photo') as HTMLImageElement | null;
      const captionEl = document.getElementById('ember-caption') as HTMLElement | null;

      if (!overlay || !popup || !photo || !captionEl) return;

      // Remove animation classes
      popup.classList.remove('dismissing', 'entering');

      // Set photo source
      photo.src = isSilly ? '/ember-silly.png' : '/ember.png';

      // Position with viewport clamping — center above click point
      const POPUP_SIZE = 240;
      const popupX = Math.min(
        Math.max(x - POPUP_SIZE / 2, 15),
        window.innerWidth - POPUP_SIZE - 15
      );
      const popupY = Math.max(y - POPUP_SIZE - 20, 80);

      popup.style.left = `${popupX}px`;
      popup.style.top = `${popupY}px`;

      // Caption for silly mode
      if (isSilly) {
        const captions = ['she says hi', 'good girl', 'best dog', 'scientifically perfect'];
        captionEl.textContent = captions[(emberClickCount - 3) % captions.length];
        captionEl.style.display = 'block';
      } else {
        captionEl.style.display = 'none';
      }

      // Show overlay with entrance animation
      overlay.classList.add('active');
      // Force reflow so the animation replays
      void popup.offsetWidth;
      popup.classList.add('entering');

      // Create particles (skip if reduced motion)
      if (!prefersReduced) {
        const particleCount = Math.floor(Math.random() * 4) + 8; // 8-11 particles
        for (let i = 0; i < particleCount; i++) {
          const particle = document.createElement('span');
          particle.classList.add('ember-particle');
          particle.style.left = `${x}px`;
          particle.style.top = `${y}px`;
          particle.style.setProperty('--dx', `${Math.random() * 120 - 60}px`);
          particle.style.setProperty('--dy', `${Math.random() * -100 - 20}px`);
          document.body.appendChild(particle);

          particle.addEventListener('animationend', () => {
            particle.remove();
          });
          // Fallback cleanup in case animationend doesn't fire
          setTimeout(() => {
            if (particle.parentNode) particle.remove();
          }, 900);
        }
      }

      // Click overlay backdrop to dismiss
      overlay.addEventListener('click', (ev: Event) => {
        const target = ev.target as HTMLElement;
        if (target === overlay) {
          if (dismissTimer !== null) {
            clearTimeout(dismissTimer);
            dismissTimer = null;
          }
          dismissPopup();
        }
      });

      // Auto-dismiss after 3 seconds (longer to appreciate Ember)
      dismissTimer = setTimeout(() => {
        dismissPopup();
      }, 3000);
    }

    function dismissPopup() {
      const overlay = document.getElementById('ember-overlay') as HTMLElement | null;
      const popup = overlay?.querySelector('.ember-popup') as HTMLElement | null;

      if (!overlay || !popup) return;

      if (prefersReduced) {
        overlay.classList.remove('active');
        popup.classList.remove('entering');
        return;
      }

      popup.classList.remove('entering');
      popup.classList.add('dismissing');

      const onDone = () => {
        overlay.classList.remove('active');
        popup.classList.remove('dismissing');
        popup.removeEventListener('animationend', onDone);
      };
      popup.addEventListener('animationend', onDone);

      // Fallback in case animationend doesn't fire
      setTimeout(() => {
        overlay.classList.remove('active');
        popup.classList.remove('dismissing');
      }, 600);
    }
  }

  document.addEventListener('astro:page-load', initEmberClick);
</script>
