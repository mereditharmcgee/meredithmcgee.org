---
interface Props {
  title: string;
  description: string;
  category: string;
  slug?: string;
  role?: string;
  href?: string;
  linkLabel?: string;
  index?: number;
}

const { title, description, category, slug, role, href, linkLabel } = Astro.props;

const categoryColors: Record<string, string> = {
  RESEARCH: '#7c9a5e',
  WRITING: '#d4b968',
  GRANTS: '#b8856c',
  EVALUATION: '#8ba4b8',
  POLICY: '#a89bc4',
  TOOLS: '#c99a6a',
  PROJECTS: '#a87ba0',
};

const accentColor = categoryColors[category] || 'var(--color-gold)';

// Work out what the card links to, if anything.
let linkHref: string | null = null;
let linkText = '';
let isExternal = false;

if (slug) {
  linkHref = `/work/${slug}`;
  linkText = linkLabel || 'Read the case study';
} else if (href) {
  linkHref = href;
  linkText = linkLabel || 'Take a look';
  isExternal = href.startsWith('http');
}
---

<article class="work-card" data-category={category} style={`--accent: ${accentColor}`}>
  <div class="work-card__meta">
    <span class="work-card__category">{category}</span>
    {role && <span class="work-card__role">{role}</span>}
  </div>
  <h3 class="work-card__title">{title}</h3>
  <p class="work-card__description">{description}</p>
  {linkHref && (
    <a
      href={linkHref}
      class="work-card__link"
      {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      {linkText} <span aria-hidden="true">{isExternal ? '↗' : '→'}</span>
    </a>
  )}
</article>

<style>
  .work-card {
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(212, 201, 142, 0.12);
    transition: transform 0.3s ease;
  }

  .work-card:last-child {
    border-bottom: none;
  }

  .work-card:hover {
    transform: translateX(4px);
  }

  .work-card__meta {
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .work-card__category {
    display: inline-block;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--accent);
    border-radius: 20px;
    opacity: 0.85;
  }

  .work-card__role {
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--color-cream);
    opacity: 0.6;
  }

  .work-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-gold);
    margin: 0 0 0.5rem;
  }

  .work-card__description {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-cream);
    opacity: 0.85;
    margin: 0 0 0.75rem;
  }

  .work-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-weight: 500;
    transition: color 0.3s ease, gap 0.3s ease;
  }

  .work-card__link:hover {
    color: var(--color-cream);
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .work-card:hover {
      transform: none;
    }
  }
</style>
