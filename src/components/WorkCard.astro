---
interface Props {
  title: string;
  description: string;
  category: string;
  slug?: string;
  role?: string;
  href?: string;
  linkLabel?: string;
  thumb?: string;
  index?: number;
}

const { title, description, category, slug, role, href, linkLabel, thumb } = Astro.props;

const categoryColors: Record<string, string> = {
  RESEARCH: '#6f8250',
  WRITING: '#b26a3c',
  GRANTS: '#b0862f',
  EVALUATION: '#5f7d85',
  POLICY: '#8a6ea0',
  TOOLS: '#a5673a',
  PROJECTS: '#7d5280',
};

const accentColor = categoryColors[category] || 'var(--color-gold)';

let linkHref: string | null = null;
let linkText = '';
let isExternal = false;

if (slug) {
  linkHref = `/work/${slug}`;
  linkText = linkLabel || 'Read the case study';
} else if (href) {
  linkHref = href;
  linkText = linkLabel || 'Take a look';
  isExternal = href.startsWith('http');
}
---

<article class="work-card" data-category={category} style={`--accent: ${accentColor}`}>
  <div class="work-card__body">
    <div class="work-card__meta">
      <span class="work-card__category">{category}</span>
      {role && <span class="work-card__role">{role}</span>}
    </div>
    <h3 class="work-card__title">{title}</h3>
    <p class="work-card__description">{description}</p>
    {linkHref && (
      <a
        href={linkHref}
        class="work-card__link"
        {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {linkText} <span aria-hidden="true">{isExternal ? '↗' : '→'}</span>
      </a>
    )}
  </div>
  {thumb && (
    <div class="work-card__thumb">
      <img src={thumb} alt="" loading="lazy" />
    </div>
  )}
</article>

<style>
  .work-card {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
    padding: 1.9rem 0;
    border-bottom: 1px solid rgba(43, 40, 34, 0.12);
    transition: transform 0.3s ease;
  }

  .work-card:last-child {
    border-bottom: none;
  }

  .work-card:hover {
    transform: translateX(4px);
  }

  .work-card__body {
    flex: 1;
    min-width: 0;
  }

  .work-card__thumb {
    flex-shrink: 0;
    width: 190px;
  }

  .work-card__thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid rgba(43, 40, 34, 0.12);
    box-shadow: 0 8px 20px rgba(43, 40, 34, 0.1);
  }

  .work-card__meta {
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .work-card__category {
    display: inline-block;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--accent);
    border-radius: 20px;
    opacity: 0.9;
  }

  .work-card__role {
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--color-cream);
    opacity: 0.6;
  }

  .work-card__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-gold);
    margin: 0 0 0.5rem;
  }

  .work-card__description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.85;
    margin: 0 0 0.75rem;
  }

  .work-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-weight: 600;
    transition: color 0.3s ease, gap 0.3s ease;
  }

  .work-card__link:hover {
    gap: 0.5rem;
    filter: brightness(0.85);
  }

  @media (max-width: 640px) {
    .work-card {
      flex-direction: column-reverse;
      gap: 1rem;
    }
    .work-card__thumb {
      width: 100%;
    }
    .work-card:hover {
      transform: none;
    }
  }
</style>
