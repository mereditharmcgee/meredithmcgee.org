---
interface Props {
  title: string;
  description: string;
  category: string;
  link?: string;
}

const { title, description, category, link } = Astro.props;
---

<article class="work-card">
  <span class="work-card__category">{category}</span>
  <h3 class="work-card__title">
    {link ? (
      <a href={link} target="_blank" rel="noopener noreferrer">{title}</a>
    ) : (
      title
    )}
  </h3>
  <p class="work-card__description">{description}</p>
  {link && (
    <a href={link} target="_blank" rel="noopener noreferrer" class="work-card__link">
      Read more &rarr;
    </a>
  )}
</article>

<style>
  .work-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(212, 201, 142, 0.15);
  }

  .work-card:last-child {
    border-bottom: none;
  }

  .work-card__category {
    display: inline-block;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-cream);
    opacity: 0.6;
    margin-bottom: 0.5rem;
  }

  .work-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    color: var(--color-gold);
  }

  .work-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .work-card__title a:hover {
    color: var(--color-cream);
  }

  .work-card__description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.9;
    margin: 0;
  }

  .work-card__link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-gold);
    text-decoration: none;
    transition: color 0.3s ease;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
  }

  .work-card__link:hover {
    color: var(--color-cream);
  }
</style>
