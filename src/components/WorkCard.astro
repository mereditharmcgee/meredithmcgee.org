---
interface Props {
  title: string;
  description: string;
  category: string;
  link?: string;
  image?: string;
  index?: number;
}

const { title, description, category, link, image, index = 0 } = Astro.props;
const isEven = index % 2 === 0;

const categoryColors: Record<string, string> = {
  RESEARCH: '#7c9a5e',
  WRITING: '#d4b968',
  GRANTS: '#b8856c',
  EVALUATION: '#8ba4b8',
  POLICY: '#a89bc4',
};

const accentColor = categoryColors[category] || 'var(--color-gold)';
---

<article class={`magazine-card ${isEven ? '' : 'magazine-card--flipped'}`} style={`--accent: ${accentColor}`}>
  {image && (
    <div class="magazine-card__visual">
      <div class="magazine-card__image-wrap">
        <img src={image} alt="" loading="lazy" />
      </div>
    </div>
  )}
  <div class="magazine-card__content">
    <span class="magazine-card__category">{category}</span>
    <h3 class="magazine-card__title">
      {link ? (
        <a href={link} target="_blank" rel="noopener noreferrer">{title}</a>
      ) : (
        title
      )}
    </h3>
    <p class="magazine-card__description">{description}</p>
    {link && (
      <a href={link} target="_blank" rel="noopener noreferrer" class="magazine-card__link">
        Read more <span aria-hidden="true">&rarr;</span>
      </a>
    )}
  </div>
</article>

<style>
  .magazine-card {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 2rem;
    align-items: center;
    padding: 2rem 0;
    border-bottom: 1px solid rgba(212, 201, 142, 0.1);
    transition: transform 0.3s ease;
  }

  .magazine-card:last-child {
    border-bottom: none;
  }

  .magazine-card:hover {
    transform: translateX(4px);
  }

  .magazine-card--flipped {
    grid-template-columns: 1fr 120px;
  }

  .magazine-card--flipped .magazine-card__visual {
    order: 2;
  }

  .magazine-card--flipped .magazine-card__content {
    order: 1;
    text-align: right;
  }

  .magazine-card--flipped .magazine-card__category {
    margin-left: auto;
  }

  .magazine-card--flipped:hover {
    transform: translateX(-4px);
  }

  .magazine-card__visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .magazine-card__image-wrap {
    width: 100px;
    height: 100px;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(212, 201, 142, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .magazine-card:hover .magazine-card__image-wrap {
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .magazine-card__image-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: brightness(0.9) saturate(0.8);
    transition: filter 0.3s ease;
  }

  .magazine-card:hover .magazine-card__image-wrap img {
    filter: brightness(1) saturate(1);
  }

  .magazine-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .magazine-card__category {
    display: inline-block;
    width: fit-content;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--accent);
    border-radius: 20px;
    opacity: 0.8;
  }

  .magazine-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-gold);
    margin: 0;
  }

  .magazine-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .magazine-card__title a:hover {
    color: var(--color-cream);
  }

  .magazine-card__description {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.85;
    margin: 0;
  }

  .magazine-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-weight: 500;
    transition: color 0.3s ease, gap 0.3s ease;
  }

  .magazine-card__link:hover {
    color: var(--color-cream);
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .magazine-card,
    .magazine-card--flipped {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: left;
    }

    .magazine-card--flipped .magazine-card__visual {
      order: 0;
    }

    .magazine-card--flipped .magazine-card__content {
      order: 0;
      text-align: left;
    }

    .magazine-card--flipped .magazine-card__category {
      margin-left: 0;
    }

    .magazine-card:hover,
    .magazine-card--flipped:hover {
      transform: none;
    }

    .magazine-card__image-wrap {
      width: 72px;
      height: 72px;
      padding: 12px;
    }
  }
</style>
