---
interface Props {
  title: string;
  description: string;
  category: string;
  index?: number;
}

const { title, description, category, index = 0 } = Astro.props;

const categoryColors: Record<string, string> = {
  RESEARCH: '#7c9a5e',
  WRITING: '#d4b968',
  GRANTS: '#b8856c',
  EVALUATION: '#8ba4b8',
  POLICY: '#a89bc4',
};

const accentColor = categoryColors[category] || 'var(--color-gold)';
---

<article class="work-card" style={`--accent: ${accentColor}`}>
  <div class="work-card__meta">
    <span class="work-card__category">{category}</span>
  </div>
  <h3 class="work-card__title">{title}</h3>
  <p class="work-card__description">{description}</p>
  <a href="/work" class="work-card__link">
    See more work <span aria-hidden="true">&rarr;</span>
  </a>
</article>

<style>
  .work-card {
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(212, 201, 142, 0.12);
    transition: transform 0.3s ease;
  }

  .work-card:last-child {
    border-bottom: none;
  }

  .work-card:hover {
    transform: translateX(4px);
  }

  .work-card__meta {
    margin-bottom: 0.6rem;
  }

  .work-card__category {
    display: inline-block;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--accent);
    border-radius: 20px;
    opacity: 0.85;
  }

  .work-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-gold);
    margin: 0 0 0.5rem;
  }

  .work-card__description {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-cream);
    opacity: 0.85;
    margin: 0 0 0.75rem;
  }

  .work-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-weight: 500;
    transition: color 0.3s ease, gap 0.3s ease;
  }

  .work-card__link:hover {
    color: var(--color-cream);
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .work-card:hover {
      transform: none;
    }
  }
</style>
