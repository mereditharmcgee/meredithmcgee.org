---
// One row in the work archive (/work/archive). The archive keeps its own
// layout and takes only the site's fonts and color tokens.
import type { Verb } from '../data/work';

interface Props {
  title: string;
  description: string;
  category: string;
  verb: Verb;
  slug?: string;
  role?: string;
  href?: string;
  linkLabel?: string;
}

const { title, description, category, verb, slug, role, href, linkLabel } = Astro.props;

// Each of the four verbs owns a color everywhere on the site.
const verbColors: Record<Verb, string> = {
  study: 'var(--tea-700)',
  write: 'var(--raspberry-700)',
  build: 'var(--blue-700)',
  fund: 'var(--olive-700)',
};

const accentColor = verbColors[verb];

let linkHref: string | null = null;
let linkText = '';
let isExternal = false;

if (slug) {
  linkHref = `/work/${slug}`;
  linkText = 'Read the case study';
} else if (href) {
  linkHref = href;
  linkText = linkLabel || 'Take a look';
  isExternal = href.startsWith('http');
}
---

<article class="work-card" data-category={category} style={`--accent: ${accentColor}`}>
  <div class="work-card__body">
    <div class="work-card__meta">
      <span class="work-card__category">{category}</span>
      {role && <span class="work-card__role">{role}</span>}
    </div>
    <h3 class="work-card__title">{title}</h3>
    <p class="work-card__description">{description}</p>
    {linkHref && (
      <a
        href={linkHref}
        class="work-card__link"
        {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {linkText} <span aria-hidden="true">{isExternal ? '↗' : '→'}</span>
      </a>
    )}
  </div>
</article>

<style>
  .work-card {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
    padding: 1.9rem 0;
    border-bottom: 1px solid var(--line);
    transition: transform 0.3s ease;
  }

  .work-card:last-child {
    border-bottom: none;
  }

  .work-card:hover {
    transform: translateX(4px);
  }

  .work-card__body {
    flex: 1;
    min-width: 0;
  }

  .work-card__meta {
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .work-card__category {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--accent);
    border-radius: 20px;
    opacity: 0.9;
  }

  .work-card__role {
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--tea-700);
  }

  .work-card__title {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }

  .work-card__description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 0.75rem;
  }

  .work-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 600;
    transition: color 0.3s ease, gap 0.3s ease;
  }

  .work-card__link:hover {
    gap: 0.5rem;
    filter: brightness(0.85);
  }

  @media (max-width: 640px) {
    .work-card {
      flex-direction: column;
      gap: 1rem;
    }
    .work-card:hover {
      transform: none;
    }
  }
</style>
