---
// Styles for the footer live in src/styles/global.css under "Header and footer".
import Wordmark from './Wordmark.astro';
import { CONTACT_EMAIL, FOOTER_AVAILABILITY, FOOTER_ROLE, LINKEDIN_URL, SITE_TITLE, SUBSTACK_URL } from '../consts';

const currentYear = new Date().getFullYear();
---

<footer class="ft">
	<div class="wrap ft-in">
		<div class="ft-id">
			<Wordmark size={30} lazy />
			<p>{FOOTER_ROLE} {FOOTER_AVAILABILITY}</p>
		</div>
		<p class="ft-links">
			<span class="email small">{CONTACT_EMAIL}</span>
			<a href="/Meredith-McGee-CV.pdf" target="_blank" rel="noopener">CV (PDF)</a>
			<a href="/work-with-me">Work with me</a>
			<a href="/tools/kappa" target="_blank" rel="noopener">Tools</a>
			<a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
			<a href={SUBSTACK_URL} target="_blank" rel="noopener">Substack</a>
		</p>
		<div class="ft-base">
			<p>&copy; {currentYear} {SITE_TITLE}. All rights reserved.</p>
			<p><em>made with care, coffee, and a black lab at my feet</em></p>
		</div>
	</div>
</footer>
