---
const currentYear = new Date().getFullYear();
---

<footer>
	<div class="container">
		<div class="footer-content">
			<h3>Meredith McGee</h3>
			<p class="footer-subtitle">Public health writer, evaluator, and researcher</p>
			<p class="footer-email">
				<a href="mailto:meredith.ar.mcgee@gmail.com">meredith.ar.mcgee@gmail.com</a>
			</p>
			<p class="footer-resume">
				<a href="/Meredith-McGee-CV.pdf" target="_blank" rel="noopener">CV (PDF)</a>
			</p>
			<div class="footer-social">
				<a href="https://www.linkedin.com/in/meredith-mcgee-mph/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
				</a>
				<a href="https://groundlevelmm.substack.com" target="_blank" rel="noopener noreferrer" aria-label="Substack">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
						<path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/>
					</svg>
				</a>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; {currentYear} Meredith McGee. All rights reserved.</p>
			<p class="footer-secret">made with care, coffee, and a black lab at my feet</p>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 2.5rem 0 1.5rem;
		background: var(--color-dark);
	}

	footer .container {
		max-width: 1100px;
		padding: 0 2rem;
	}

	.footer-content {
		text-align: center;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgba(212, 201, 142, 0.3);
	}

	.footer-content h3 {
		font-family: 'Playfair Display', Georgia, serif;
		color: var(--color-gold);
		font-size: 1.25rem;
		margin-bottom: 0.25rem;
	}

	.footer-subtitle {
		color: var(--color-cream);
		font-size: 0.9rem;
		margin-bottom: 1rem;
	}

	.footer-email {
		margin-bottom: 0.75rem;
	}

	.footer-email a {
		color: var(--color-cream);
		text-decoration: none;
		font-size: 0.875rem;
	}

	.footer-email a:hover {
		text-decoration: underline;
		color: var(--color-gold);
	}

	.footer-social {
		display: flex;
		gap: 1rem;
		justify-content: center;
		margin-top: 0.5rem;
	}

	.footer-social a {
		color: var(--color-cream);
		transition: color 0.3s ease;
		display: flex;
		align-items: center;
	}

	.footer-social a:hover {
		color: var(--color-gold);
	}

	.footer-bottom {
		padding-top: 1rem;
		text-align: center;
	}

	.footer-bottom p {
		color: var(--color-cream);
		font-size: 0.75rem;
		opacity: 0.8;
		margin: 0;
	}

	.footer-secret {
		color: rgba(45, 58, 30, 0.03);
		font-size: 0.65rem;
		margin-top: 0.5rem;
		cursor: default;
		transition: color 0.4s ease;
		user-select: none;
		text-align: center;
		letter-spacing: 0.02em;
		opacity: 1;
	}

	.footer-secret:hover,
	.footer-secret.revealed {
		color: rgba(236, 230, 208, 0.35);
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-secret {
			transition: none;
		}
	}

	@media (max-width: 768px) {
		footer .container {
			padding: 0 1.5rem;
		}

		.footer-content h3 {
			font-size: 1.1rem;
		}

		.footer-subtitle {
			font-size: 0.85rem;
		}
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		const secret = document.querySelector('.footer-secret');
		if (!secret) return;

		// Mobile tap reveal (hover doesn't work on touch)
		secret.addEventListener('click', () => {
			secret.classList.toggle('revealed');
		});
	});
</script>
