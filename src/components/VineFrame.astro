---
// VineFrame.astro
// Wraps content (a photo) with a botanical vine that traces the border and grows on scroll.
// The vine hugs the photo edge (rounded rect) — never crossing over the image.
// Leaves are proper botanical shapes with central veins.
---

<div class="vine-frame">
  <svg class="vine-svg" viewBox="0 0 320 380" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- Main vine — hugs the rounded-rect border of the photo.
         Starts bottom-center, traces right edge up, across top, down left edge.
         The photo sits at roughly (20,20) to (300,360) with 16px border-radius. -->
    <path
      class="vine-stem"
      d="M 160 365
         C 165 365, 200 366, 230 364
         C 260 362, 280 358, 290 348
         Q 302 336, 303 310
         C 304 280, 305 250, 303 220
         C 301 190, 302 160, 303 130
         C 304 100, 303 70, 298 48
         Q 290 26, 270 22
         C 245 18, 210 17, 175 17
         C 140 17, 105 18, 75 21
         Q 32 26, 24 48
         C 19 68, 18 95, 18 125
         C 18 155, 19 185, 19 215
         C 19 245, 18 275, 19 305
         Q 20 338, 35 350
         C 48 360, 75 363, 100 364"
      stroke="var(--color-gold)"
      stroke-width="1.5"
      stroke-linecap="round"
      fill="none"
      opacity="0.8"
    />

    <!-- Thin curling tendrils branching off the vine -->
    <g class="vine-tendrils">
      <path class="vine-tendril vine-leaf-2" d="M 290 340 C 296 335, 310 330, 315 320 C 318 314, 312 312, 308 318" stroke="var(--color-gold)" stroke-width="0.8" fill="none" opacity="0" />
      <path class="vine-tendril vine-leaf-5" d="M 304 200 C 312 195, 318 185, 315 178 C 313 173, 307 177, 310 183" stroke="var(--color-gold)" stroke-width="0.8" fill="none" opacity="0" />
      <path class="vine-tendril vine-leaf-8" d="M 270 20 C 275 10, 280 2, 275 -4 C 272 -8, 266 -3, 270 4" stroke="var(--color-gold)" stroke-width="0.8" fill="none" opacity="0" />
      <path class="vine-tendril vine-leaf-11" d="M 18 170 C 8 165, -2 158, -6 165 C -8 170, -2 173, 4 168" stroke="var(--color-gold)" stroke-width="0.8" fill="none" opacity="0" />
      <path class="vine-tendril vine-leaf-14" d="M 22 310 C 12 315, 2 322, 5 330 C 7 335, 14 330, 10 324" stroke="var(--color-gold)" stroke-width="0.8" fill="none" opacity="0" />
    </g>

    <!-- Botanical leaves with central veins — positioned along the border vine -->
    <g class="vine-leaves">

      <!-- BOTTOM-RIGHT corner area -->
      <g class="vine-leaf vine-leaf-1" opacity="0" transform="translate(260, 358) rotate(-30)">
        <path d="M 0 0 C 8 -12, 20 -18, 24 -10 C 28 -2, 16 6, 0 0Z" fill="var(--color-medium)" />
        <path d="M 0 0 C 6 -8, 14 -12, 20 -8" stroke="var(--color-light)" stroke-width="0.5" fill="none" />
      </g>

      <!-- RIGHT edge — lower -->
      <g class="vine-leaf vine-leaf-3" opacity="0" transform="translate(305, 280) rotate(-80)">
        <path d="M 0 0 C 6 -14, 18 -22, 24 -14 C 30 -6, 14 6, 0 0Z" fill="var(--color-light)" />
        <path d="M 0 0 C 5 -10, 12 -16, 20 -12" stroke="var(--color-medium)" stroke-width="0.5" fill="none" />
      </g>

      <!-- RIGHT edge — mid -->
      <g class="vine-leaf vine-leaf-4" opacity="0" transform="translate(302, 200) rotate(-95)">
        <path d="M 0 0 C 7 -11, 17 -17, 22 -10 C 27 -3, 13 5, 0 0Z" fill="var(--color-medium)" />
        <path d="M 0 0 C 5 -8, 11 -12, 18 -8" stroke="var(--color-light)" stroke-width="0.5" fill="none" />
      </g>

      <!-- RIGHT edge — upper -->
      <g class="vine-leaf vine-leaf-6" opacity="0" transform="translate(304, 120) rotate(-85)">
        <path d="M 0 0 C 8 -13, 20 -20, 26 -12 C 32 -4, 16 7, 0 0Z" fill="var(--color-light)" />
        <path d="M 0 0 C 6 -9, 14 -14, 22 -10" stroke="var(--color-medium)" stroke-width="0.5" fill="none" />
      </g>

      <!-- TOP-RIGHT corner -->
      <g class="vine-leaf vine-leaf-7" opacity="0" transform="translate(288, 28) rotate(-25)">
        <path d="M 0 0 C 6 -14, 18 -20, 22 -12 C 26 -4, 14 6, 0 0Z" fill="var(--color-medium)" />
        <path d="M 0 0 C 5 -10, 12 -15, 18 -10" stroke="var(--color-light)" stroke-width="0.5" fill="none" />
      </g>

      <!-- TOP edge — right of center -->
      <g class="vine-leaf vine-leaf-9" opacity="0" transform="translate(220, 17) rotate(5)">
        <path d="M 0 0 C 5 -15, 16 -22, 22 -14 C 28 -6, 12 5, 0 0Z" fill="var(--color-light)" />
        <path d="M 0 0 C 4 -10, 10 -16, 18 -12" stroke="var(--color-medium)" stroke-width="0.5" fill="none" />
      </g>

      <!-- TOP edge — left of center -->
      <g class="vine-leaf vine-leaf-10" opacity="0" transform="translate(120, 19) rotate(15)">
        <path d="M 0 0 C 7 -13, 19 -19, 24 -11 C 29 -3, 15 6, 0 0Z" fill="var(--color-medium)" />
        <path d="M 0 0 C 5 -9, 13 -14, 20 -9" stroke="var(--color-light)" stroke-width="0.5" fill="none" />
      </g>

      <!-- TOP-LEFT corner -->
      <g class="vine-leaf vine-leaf-12" opacity="0" transform="translate(35, 32) rotate(40)">
        <path d="M 0 0 C 6 -14, 18 -20, 23 -12 C 28 -4, 14 6, 0 0Z" fill="var(--color-light)" />
        <path d="M 0 0 C 5 -10, 12 -15, 19 -10" stroke="var(--color-medium)" stroke-width="0.5" fill="none" />
      </g>

      <!-- LEFT edge — upper -->
      <g class="vine-leaf vine-leaf-13" opacity="0" transform="translate(18, 105) rotate(85)">
        <path d="M 0 0 C 7 -12, 18 -18, 23 -10 C 28 -2, 14 6, 0 0Z" fill="var(--color-medium)" />
        <path d="M 0 0 C 5 -8, 12 -13, 19 -8" stroke="var(--color-light)" stroke-width="0.5" fill="none" />
      </g>

      <!-- LEFT edge — mid -->
      <g class="vine-leaf vine-leaf-15" opacity="0" transform="translate(19, 195) rotate(90)">
        <path d="M 0 0 C 8 -13, 20 -20, 26 -12 C 32 -4, 16 7, 0 0Z" fill="var(--color-light)" />
        <path d="M 0 0 C 6 -9, 14 -14, 22 -10" stroke="var(--color-medium)" stroke-width="0.5" fill="none" />
      </g>

      <!-- LEFT edge — lower -->
      <g class="vine-leaf vine-leaf-16" opacity="0" transform="translate(19, 285) rotate(95)">
        <path d="M 0 0 C 6 -12, 17 -18, 22 -10 C 27 -2, 13 5, 0 0Z" fill="var(--color-medium)" />
        <path d="M 0 0 C 5 -8, 11 -13, 18 -8" stroke="var(--color-light)" stroke-width="0.5" fill="none" />
      </g>

      <!-- BOTTOM-LEFT corner -->
      <g class="vine-leaf vine-leaf-17" opacity="0" transform="translate(38, 355) rotate(145)">
        <path d="M 0 0 C 7 -13, 19 -19, 24 -11 C 29 -3, 15 6, 0 0Z" fill="var(--color-light)" />
        <path d="M 0 0 C 5 -9, 13 -14, 20 -9" stroke="var(--color-medium)" stroke-width="0.5" fill="none" />
      </g>

      <!-- Small buds along the vine for extra detail -->
      <circle class="vine-leaf vine-leaf-18" cx="300" cy="330" r="2.5" fill="var(--color-gold)" opacity="0" />
      <circle class="vine-leaf vine-leaf-19" cx="305" cy="160" r="2" fill="var(--color-gold)" opacity="0" />
      <circle class="vine-leaf vine-leaf-20" cx="298" cy="60" r="2.5" fill="var(--color-gold)" opacity="0" />
      <circle class="vine-leaf vine-leaf-21" cx="170" cy="16" r="2" fill="var(--color-gold)" opacity="0" />
      <circle class="vine-leaf vine-leaf-22" cx="70" cy="22" r="2.5" fill="var(--color-gold)" opacity="0" />
      <circle class="vine-leaf vine-leaf-23" cx="17" cy="150" r="2" fill="var(--color-gold)" opacity="0" />
      <circle class="vine-leaf vine-leaf-24" cx="18" cy="240" r="2.5" fill="var(--color-gold)" opacity="0" />
      <circle class="vine-leaf vine-leaf-25" cx="28" cy="350" r="2" fill="var(--color-gold)" opacity="0" />
    </g>
  </svg>

  <div class="vine-frame__content">
    <slot />
  </div>
</div>

<style>
  .vine-frame {
    position: relative;
    display: inline-block;
  }

  .vine-svg {
    position: absolute;
    inset: -20px;
    width: calc(100% + 40px);
    height: calc(100% + 40px);
    pointer-events: none;
    z-index: 1;
  }

  .vine-frame__content {
    position: relative;
    z-index: 0;
  }

  /* Vine stem — draw-on animation via stroke-dashoffset */
  .vine-stem {
    stroke-dasharray: 1800;
    stroke-dashoffset: 1800;
    transition: stroke-dashoffset 3.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .vine-frame.in-view .vine-stem {
    stroke-dashoffset: 0;
  }

  /* Tendrils draw in like the stem */
  .vine-tendril {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    transition: stroke-dashoffset 0.6s ease, opacity 0.4s ease;
  }

  /* Leaves fade + scale in for a "sprouting" feel */
  .vine-leaf {
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  /* Right side — bottom to top (follows vine drawing direction) */
  .vine-frame.in-view .vine-leaf-1  { opacity: 0.75; transition-delay: 0.3s; }
  .vine-frame.in-view .vine-leaf-2  { opacity: 0.7; transition-delay: 0.5s; stroke-dashoffset: 0; }
  .vine-frame.in-view .vine-leaf-3  { opacity: 0.7; transition-delay: 0.7s; }
  .vine-frame.in-view .vine-leaf-4  { opacity: 0.75; transition-delay: 1.0s; }
  .vine-frame.in-view .vine-leaf-5  { opacity: 0.7; transition-delay: 1.1s; stroke-dashoffset: 0; }
  .vine-frame.in-view .vine-leaf-6  { opacity: 0.7; transition-delay: 1.3s; }
  .vine-frame.in-view .vine-leaf-7  { opacity: 0.75; transition-delay: 1.5s; }

  /* Top edge — right to left */
  .vine-frame.in-view .vine-leaf-8  { opacity: 0.7; transition-delay: 1.6s; stroke-dashoffset: 0; }
  .vine-frame.in-view .vine-leaf-9  { opacity: 0.7; transition-delay: 1.7s; }
  .vine-frame.in-view .vine-leaf-10 { opacity: 0.75; transition-delay: 1.9s; }
  .vine-frame.in-view .vine-leaf-11 { opacity: 0.7; transition-delay: 2.0s; stroke-dashoffset: 0; }
  .vine-frame.in-view .vine-leaf-12 { opacity: 0.7; transition-delay: 2.1s; }

  /* Left side — top to bottom */
  .vine-frame.in-view .vine-leaf-13 { opacity: 0.75; transition-delay: 2.2s; }
  .vine-frame.in-view .vine-leaf-14 { opacity: 0.7; transition-delay: 2.4s; stroke-dashoffset: 0; }
  .vine-frame.in-view .vine-leaf-15 { opacity: 0.7; transition-delay: 2.5s; }
  .vine-frame.in-view .vine-leaf-16 { opacity: 0.75; transition-delay: 2.7s; }
  .vine-frame.in-view .vine-leaf-17 { opacity: 0.7; transition-delay: 2.9s; }

  /* Small buds — scattered timing */
  .vine-frame.in-view .vine-leaf-18 { opacity: 0.8; transition-delay: 0.6s; }
  .vine-frame.in-view .vine-leaf-19 { opacity: 0.8; transition-delay: 1.15s; }
  .vine-frame.in-view .vine-leaf-20 { opacity: 0.8; transition-delay: 1.45s; }
  .vine-frame.in-view .vine-leaf-21 { opacity: 0.8; transition-delay: 1.8s; }
  .vine-frame.in-view .vine-leaf-22 { opacity: 0.8; transition-delay: 2.05s; }
  .vine-frame.in-view .vine-leaf-23 { opacity: 0.8; transition-delay: 2.35s; }
  .vine-frame.in-view .vine-leaf-24 { opacity: 0.8; transition-delay: 2.65s; }
  .vine-frame.in-view .vine-leaf-25 { opacity: 0.8; transition-delay: 2.85s; }

  /* Reduced motion: show everything immediately, no animation */
  @media (prefers-reduced-motion: reduce) {
    .vine-stem {
      stroke-dashoffset: 0;
      transition: none;
    }
    .vine-tendril {
      stroke-dashoffset: 0;
      transition: none;
    }
    .vine-leaf {
      opacity: 0.7 !important;
      transition: none !important;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const vineFrame = document.querySelector('.vine-frame');
    if (!vineFrame) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      vineFrame.classList.add('in-view');
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            vineFrame.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    observer.observe(vineFrame);
  });
</script>
