---
import { XMLParser } from 'fast-xml-parser';
import { SUBSTACK_FEED_URL, SUBSTACK_URL } from '../consts';

interface Props {
  limit?: number;
}

interface SubstackPost {
  title: string;
  excerpt: string;
  url: string;
  date: Date;
}

const { limit = 3 } = Astro.props;

let posts: SubstackPost[] = [];

try {
  const res = await fetch(SUBSTACK_FEED_URL);
  if (!res.ok) {
    throw new Error(`RSS fetch failed: ${res.status}`);
  }
  const xml = await res.text();

  const parser = new XMLParser({
    ignoreAttributes: false,
    cdataPropName: '__cdata',
  });

  const result = parser.parse(xml);
  const rawItems = result?.rss?.channel?.item;

  // Normalize: fast-xml-parser returns an object (not array) when there's only 1 item
  const items = Array.isArray(rawItems) ? rawItems : rawItems ? [rawItems] : [];

  posts = items.slice(0, limit).map((item: any) => {
    // Handle CDATA-wrapped fields: value may be string or { __cdata: string }
    const getField = (val: any): string => {
      if (typeof val === 'string') return val;
      if (val && typeof val.__cdata === 'string') return val.__cdata;
      return '';
    };

    return {
      title: getField(item.title),
      excerpt: getField(item.description),
      url: typeof item.link === 'string' ? item.link : '',
      date: new Date(item.pubDate),
    };
  });
} catch (e) {
  // Build continues; posts stays empty, fallback renders below
  console.warn('[SubstackFeed] Failed to fetch RSS feed:', e instanceof Error ? e.message : e);
}
---

{posts.length > 0 ? (
  <div class="newspaper-feed">
    {posts.map((post, i) => (
      <article class={`newspaper-item ${i === 0 ? 'newspaper-item--lead' : ''}`}>
        <div class="newspaper-item__dateline">
          <time datetime={post.date.toISOString()}>
            {post.date.toLocaleDateString('en-US', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            }).toUpperCase()}
          </time>
        </div>
        <h3 class="newspaper-item__headline">
          <a href={post.url} target="_blank" rel="noopener noreferrer">
            {post.title}
          </a>
        </h3>
        <p class="newspaper-item__lede">{post.excerpt}</p>
      </article>
    ))}
    <div class="newspaper-more">
      <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer" class="newspaper-more__link">
        Read the full archive on Substack <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
) : (
  <div class="newspaper-feed newspaper-feed--fallback">
    <p>
      Read the latest on <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer">Substack</a>.
    </p>
  </div>
)}

<style>
  .newspaper-feed {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 2px solid var(--color-gold);
    padding-top: 1.5rem;
  }

  .newspaper-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(212, 201, 142, 0.15);
  }

  .newspaper-item:last-of-type {
    border-bottom: none;
  }

  /* Lead story gets bigger treatment */
  .newspaper-item--lead .newspaper-item__headline {
    font-size: clamp(1.3rem, 2.5vw, 1.65rem);
  }

  .newspaper-item--lead .newspaper-item__lede {
    font-size: 1rem;
  }

  .newspaper-item__dateline {
    margin-bottom: 0.4rem;
  }

  .newspaper-item__dateline time {
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .newspaper-item__headline {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  .newspaper-item__headline a {
    color: var(--color-gold);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .newspaper-item__headline a:hover {
    color: var(--color-cream);
  }

  .newspaper-item__lede {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.85;
    margin: 0;
  }

  .newspaper-more {
    padding-top: 1.25rem;
    text-align: center;
  }

  .newspaper-more__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-gold);
    text-decoration: none;
    transition: color 0.3s ease, gap 0.3s ease;
  }

  .newspaper-more__link:hover {
    color: var(--color-cream);
    gap: 0.55rem;
  }

  /* Fallback */
  .newspaper-feed--fallback {
    border-top: none;
    padding-top: 0;
  }

  .newspaper-feed--fallback p {
    font-size: 1rem;
    color: var(--color-cream);
  }

  .newspaper-feed--fallback a {
    color: var(--color-gold);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: color 0.3s ease;
  }

  .newspaper-feed--fallback a:hover {
    color: var(--color-cream);
  }
</style>
