---
// Interests.astro
// Focus areas displayed as botanical specimen-style cards.
// Each card has a specimen number, title, personal one-liner, and a small botanical SVG accent.

const interests = [
  {
    title: 'LGBTQ+ Population Health',
    description: 'Research and programming for communities that health systems tend to overlook.',
  },
  {
    title: 'Cannabis Policy',
    description: 'What happens when cannabis goes legal — who benefits, who doesn\'t, and why.',
  },
  {
    title: 'Fundraising & Development',
    description: 'Writing grants, building budgets, making the case for things that need funding.',
  },
  {
    title: 'Public Health Writing',
    description: 'Translating research into writing that people outside academia actually read.',
  },
  {
    title: 'Community Building',
    description: 'Gender-inclusive housing, LGBTQ+ programming, community spaces — the infrastructure work.',
  },
  {
    title: 'AI & Public Health',
    description: 'How AI changes public health work. Still figuring this one out.',
  },
];

---

<section class="interests bg-medium">
  <div class="container">
    <h2 class="animate-on-scroll">Things I think about</h2>
    <div class="interests-grid">
      {interests.map((item, i) => (
        <article class="interest-card">
          <span class="interest-num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="interest-title">{item.title}</h3>
          <p class="interest-desc">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .interests {
    padding: 5rem 0;
  }

  .interests .container {
    max-width: 900px;
  }

  .interests h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  /* Thin gold rule beneath heading — editorial accent */
  .interests h2::after {
    content: '';
    display: block;
    width: 48px;
    height: 1.5px;
    background: var(--color-gold);
    margin: 0.75rem auto 2.5rem;
    opacity: 0.45;
  }

  .interests-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .interest-card {
    position: relative;
    background: rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(212, 201, 142, 0.08);
    border-left: 3px solid rgba(212, 185, 104, 0.45);
    border-radius: 8px;
    padding: 1.4rem 1.25rem 1.4rem 1.15rem;
    overflow: hidden;
    /* Start hidden for scroll-in animation */
    opacity: 0;
    transform: translateY(14px) rotate(var(--card-rotation, 0deg));
    transition:
      opacity 0.55s ease,
      transform 0.55s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  /* Slight alternating rotations — "placed by hand" feel */
  .interest-card:nth-child(1)  { --card-rotation: -0.6deg; }
  .interest-card:nth-child(2)  { --card-rotation:  0.4deg; }
  .interest-card:nth-child(3)  { --card-rotation: -0.3deg; }
  .interest-card:nth-child(4)  { --card-rotation:  0.5deg; }
  .interest-card:nth-child(5)  { --card-rotation: -0.4deg; }
  .interest-card:nth-child(6)  { --card-rotation:  0.7deg; }

  /* Scroll-in: visible state */
  .interest-card.in-view {
    opacity: 1;
    transform: translateY(0) rotate(var(--card-rotation, 0deg));
  }

  /* Hover: lift and straighten */
  .interest-card.in-view:hover {
    transform: translateY(-4px) rotate(0deg);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
    border-left-color: var(--color-gold);
    border-color: rgba(212, 201, 142, 0.18);
  }

  .interest-num {
    display: block;
    font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    opacity: 0.5;
    margin-bottom: 0.5rem;
  }

  .interest-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(0.95rem, 1.2vw, 1.08rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-cream);
    margin: 0 0 0.45rem;
  }

  .interest-desc {
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--color-cream);
    opacity: 0.7;
    margin: 0;
  }

  /* Tablet: 2 columns */
  @media (max-width: 900px) {
    .interests-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Mobile: single column, remove rotations for cleaner feel */
  @media (max-width: 600px) {
    .interests-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .interest-card {
      --card-rotation: 0deg !important;
    }

    .interest-card {
      padding: 1.2rem 1rem 1.2rem 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interest-card {
      opacity: 1;
      transform: rotate(var(--card-rotation, 0deg));
      transition: box-shadow 0.35s ease, border-color 0.35s ease;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const grid = document.querySelector('.interests-grid');
    if (!grid) return;

    const cards = grid.querySelectorAll('.interest-card');
    if (cards.length === 0) return;

    // Reduced motion: show everything immediately
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      cards.forEach(card => card.classList.add('in-view'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Stagger each card's entrance by 80ms
            cards.forEach((card, i) => {
              setTimeout(() => card.classList.add('in-view'), i * 80);
            });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    observer.observe(grid);
  });
</script>
