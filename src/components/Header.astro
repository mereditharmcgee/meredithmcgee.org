---
// Styles for the header live in src/styles/global.css under "Header and footer".
import Wordmark from './Wordmark.astro';
import { PAGES_NOT_BUILT_YET } from '../consts';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const navLinks = [
	{ href: '/about', label: 'About' },
	{ href: '/work', label: 'Work' },
	{ href: '/how-i-work', label: 'How I work' },
	{ href: '/writing', label: 'Writing' },
	{ href: '/contact', label: 'Contact' },
	{ href: '/work-with-me', label: 'Work with me', cta: true },
].filter((link) => !PAGES_NOT_BUILT_YET.includes(link.href));

// A page under a section keeps that section lit, so the case studies
// highlight Work and the package pages highlight Work with me.
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="wrap hd">
	<Wordmark size={40} href="/" />
	<nav aria-label="Main">
		{navLinks.map((link) => (
			<a href={link.href} class:list={[{ 'nav-cta': link.cta }]} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
		))}
	</nav>
</header>
